#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
package_name="com.autosecretary"
runner="${package_name}.test/androidx.test.runner.AndroidJUnitRunner"
test_class="com.autosecretary.DataMigrationDeviceTest"
version_n=9000350
version_next=$((version_n + 1))
app_apk="${repo_dir}/app/build/outputs/apk/debug/app-debug.apk"
test_apk="${repo_dir}/app/build/outputs/apk/androidTest/debug/app-debug-androidTest.apk"

adb get-state >/dev/null

build_and_install() {
  local code="$1"
  local name="$2"
  "${repo_dir}/gradlew" --no-daemon --max-workers=1 \
    :app:assembleDebug :app:assembleDebugAndroidTest \
    -PversionCode="${code}" -PversionName="${name}"
  adb install -r "${app_apk}"
  adb install -r "${test_apk}"
}

run_phase() {
  local phase="$1"
  adb shell am instrument -w -r \
    -e class "${test_class}" \
    -e migrationPhase "${phase}" \
    "${runner}"
}

build_and_install "${version_n}" "migration-n"
run_phase seed
build_and_install "${version_next}" "migration-n-plus-one"
run_phase verify
