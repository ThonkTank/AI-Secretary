<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="@dimen/padding_small"
    android:paddingBottom="@dimen/padding_small">

    <!-- Tag-Spinner (Wochentag oder Monatstag) -->
    <Spinner
        android:id="@+id/spinner_pref_day"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_weight="1"
        android:contentDescription="@string/cd_spinner_pref_day" />

    <!-- Uhrzeit-Feld -->
    <EditText
        android:id="@+id/field_pref_time"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/margin_small"
        android:hint="@string/hint_uhrzeit"
        android:focusable="false"
        android:clickable="true"
        android:textSize="@dimen/sp_body" />

    <!-- Entfernen-Button -->
    <TextView
        android:id="@+id/btn_remove_slot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="\u2715"
        android:textSize="18sp"
        android:paddingStart="12dp"
        android:paddingTop="@dimen/padding_small"
        android:paddingEnd="@dimen/padding_small"
        android:paddingBottom="@dimen/padding_small"
        android:contentDescription="@string/cd_remove_pref_slot" />

</LinearLayout>
