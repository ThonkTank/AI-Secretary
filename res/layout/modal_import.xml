<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/modal_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_margin="@dimen/padding_large"
    android:orientation="vertical"
    android:background="@color/white"
    android:padding="@dimen/padding_medium"
    android:elevation="8dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Modal Title -->
            <TextView
                android:id="@+id/modal_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/title_import_statement"
                android:textSize="@dimen/sp_heading"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="@dimen/padding_medium" />

            <!-- Info Text -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/desc_import_info"
                android:textSize="@dimen/sp_caption"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="@dimen/padding_medium" />

            <!-- Konto -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_ziel_konto"
                android:textSize="@dimen/sp_caption"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/spinner_account"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@color/surface"
                android:padding="@dimen/padding_small"
                android:layout_marginBottom="@dimen/padding_medium"
                android:contentDescription="@string/cd_spinner_account" />

            <!-- Datei auswaehlen -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_kontoauszug"
                android:textSize="@dimen/sp_caption"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/padding_medium">

                <TextView
                    android:id="@+id/btn_select_file"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:paddingStart="@dimen/padding_medium"
                    android:paddingEnd="@dimen/padding_medium"
                    android:text="@string/btn_select_file"
                    android:textColor="@color/white"
                    android:background="@color/accent"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/text_filename"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/desc_no_file"
                    android:textSize="@dimen/sp_caption"
                    android:textColor="@color/text_secondary"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/padding_small"
                    android:ellipsize="middle"
                    android:singleLine="true" />
            </LinearLayout>

            <!-- API Key Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_api_key"
                android:textSize="@dimen/sp_caption"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:id="@+id/api_key_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/padding_small">

                <EditText
                    android:id="@+id/input_api_key"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:hint="@string/hint_api_key"
                    android:inputType="textPassword"
                    android:textSize="@dimen/sp_body"
                    android:background="@color/surface"
                    android:padding="@dimen/padding_small" />

                <TextView
                    android:id="@+id/btn_toggle_key"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="👁"
                    android:textSize="@dimen/sp_body"
                    android:background="@color/surface"
                    android:gravity="center"
                    android:layout_marginStart="4dp"
                    android:contentDescription="@string/cd_toggle_api_key" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/checkbox_save_key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_save_api_key"
                android:textSize="@dimen/sp_caption"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="@dimen/padding_medium" />

            <!-- Progress Section (hidden by default) -->
            <LinearLayout
                android:id="@+id/progress_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginBottom="@dimen/padding_medium">

                <ProgressBar
                    android:id="@+id/progress_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:indeterminate="true" />

                <TextView
                    android:id="@+id/progress_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/desc_processing"
                    android:textSize="@dimen/sp_caption"
                    android:textColor="@color/text_secondary"
                    android:gravity="center"
                    android:layout_marginTop="@dimen/padding_small" />
            </LinearLayout>

            <!-- Result Section (hidden by default) -->
            <LinearLayout
                android:id="@+id/result_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:background="@color/budget_positive_bg"
                android:padding="@dimen/padding_small"
                android:layout_marginBottom="@dimen/padding_medium">

                <TextView
                    android:id="@+id/result_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/desc_import_complete"
                    android:textSize="@dimen/sp_body"
                    android:textStyle="bold"
                    android:textColor="@color/budget_positive" />

                <TextView
                    android:id="@+id/result_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="23 neue Transaktionen\n5 Duplikate uebersprungen"
                    android:textSize="@dimen/sp_caption"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Error Text -->
            <TextView
                android:id="@+id/error_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_error"
                android:textSize="@dimen/sp_caption"
                android:visibility="gone"
                android:layout_marginBottom="@dimen/padding_small" />

        </LinearLayout>
    </ScrollView>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/padding_medium">

        <TextView
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/btn_cancel"
            android:textColor="@color/text_secondary"
            android:background="@color/button_inactive"
            android:gravity="center"
            android:layout_marginEnd="@dimen/padding_small" />

        <TextView
            android:id="@+id/btn_import"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/btn_import"
            android:textColor="@color/white"
            android:background="@color/accent"
            android:gravity="center"
            android:layout_marginStart="@dimen/padding_small" />
    </LinearLayout>

</LinearLayout>
