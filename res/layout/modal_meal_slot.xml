<?xml version="1.0" encoding="utf-8"?>
<!-- Unified Modal: Schedule-Slot erstellen/bearbeiten + Rezept zuweisen -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/overlay_dim">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            android:elevation="8dp"
            android:orientation="vertical"
            android:padding="@dimen/padding_large"
            android:clickable="true">

            <!-- Titel -->
            <TextView
                android:id="@+id/modal_meal_slot_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_add_meal_slot"
                android:textSize="@dimen/sp_heading"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <!-- Wochentag -->
            <TextView style="@style/FormLabel"
                android:text="@string/label_wochentag"
                android:layout_marginTop="16dp" />
            <Spinner
                android:id="@+id/spinner_slot_day"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@color/surface_elevated"
                android:padding="@dimen/padding_small"
                android:contentDescription="@string/cd_spinner_day" />

            <!-- Mahlzeit-Typ -->
            <TextView style="@style/FormLabel"
                android:text="@string/label_mahlzeit"
                android:layout_marginTop="12dp" />
            <Spinner
                android:id="@+id/spinner_slot_meal_type"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@color/surface_elevated"
                android:padding="@dimen/padding_small"
                android:contentDescription="@string/cd_spinner_meal_type" />

            <!-- Startzeit + Endzeit -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <!-- Start -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">

                    <TextView style="@style/FormLabel"
                        android:text="@string/label_start" />
                    <TextView
                        android:id="@+id/slot_start_time"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@color/surface_elevated"
                        android:padding="@dimen/padding_small"
                        android:gravity="center_vertical"
                        android:textColor="@color/accent"
                        android:textSize="16sp"
                        android:text="12:00" />
                </LinearLayout>

                <!-- Ende -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <TextView style="@style/FormLabel"
                        android:text="@string/label_ende" />
                    <TextView
                        android:id="@+id/slot_end_time"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@color/surface_elevated"
                        android:padding="@dimen/padding_small"
                        android:gravity="center_vertical"
                        android:textColor="@color/accent"
                        android:textSize="16sp"
                        android:text="12:30" />
                </LinearLayout>

            </LinearLayout>

            <!-- Rezept-Sektion (nur bei Edit sichtbar) -->
            <LinearLayout
                android:id="@+id/slot_recipe_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp"
                android:visibility="gone">

                <TextView style="@style/FormLabel"
                    android:text="@string/label_rezept" />
                <Spinner
                    android:id="@+id/spinner_slot_recipe"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@color/surface_elevated"
                    android:padding="@dimen/padding_small"
                    android:contentDescription="@string/cd_spinner_recipe" />

                <!-- Rezept-Info -->
                <LinearLayout
                    android:id="@+id/slot_recipe_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/margin_small"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/slot_recipe_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/text_tertiary"
                        android:text="30 min" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="8dp"
                        android:textSize="12sp"
                        android:textColor="@color/text_tertiary"
                        android:text=" • " />

                    <TextView
                        android:id="@+id/slot_recipe_calories"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/text_tertiary"
                        android:text="450 kcal" />
                </LinearLayout>

                <!-- Portionen -->
                <TextView style="@style/FormLabel"
                    android:text="@string/label_portionen"
                    android:layout_marginTop="12dp" />
                <EditText
                    android:id="@+id/input_slot_servings"
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="2"
                    android:textSize="@dimen/sp_body" />

            </LinearLayout>

            <!-- Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="24dp">

                <Button
                    android:id="@+id/btn_slot_delete"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="@string/btn_delete"
                    android:textColor="@color/error"
                    android:background="@android:color/transparent"
                    android:visibility="gone" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/btn_slot_cancel"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="@string/btn_cancel"
                    android:textColor="@color/text_secondary"
                    android:background="@android:color/transparent" />

                <Button
                    android:id="@+id/btn_slot_save"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="16dp"
                    android:text="@string/btn_save"
                    android:textColor="@android:color/white"
                    android:background="@color/accent" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</FrameLayout>
