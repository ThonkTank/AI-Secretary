<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/candidate_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="@dimen/padding_medium"
    android:background="@color/surface"
    android:layout_marginBottom="@dimen/padding_small">

    <!-- Checkbox (ImageView fuer Toggle) -->
    <ImageView
        android:id="@+id/candidate_checkbox"
        android:layout_width="@dimen/checkbox_size"
        android:layout_height="@dimen/checkbox_size"
        android:src="@android:drawable/checkbox_off_background"
        android:contentDescription="Auswaehlen"
        android:layout_marginEnd="@dimen/padding_medium" />

    <!-- Content -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Payee Name -->
        <TextView
            android:id="@+id/candidate_payee"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Netflix"
            android:textSize="@dimen/sp_body"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:singleLine="true"
            android:ellipsize="end" />

        <!-- Pattern Description -->
        <TextView
            android:id="@+id/candidate_pattern"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Monatlich am 15. \u2022 ~12,99 EUR"
            android:textSize="@dimen/sp_caption"
            android:textColor="@color/text_secondary"
            android:singleLine="true"
            android:layout_marginTop="2dp" />

        <!-- Transaction Count + Confidence -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/candidate_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5 Transaktionen"
                android:textSize="@dimen/sp_small"
                android:textColor="@color/text_muted" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" \u2022 "
                android:textSize="@dimen/sp_small"
                android:textColor="@color/text_muted" />

            <!-- Confidence Indicator -->
            <TextView
                android:id="@+id/candidate_confidence"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="85% sicher"
                android:textSize="@dimen/sp_small"
                android:textColor="@color/status_success" />
        </LinearLayout>
    </LinearLayout>

    <!-- Amount Badge -->
    <TextView
        android:id="@+id/candidate_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-12,99 EUR"
        android:textSize="@dimen/sp_caption"
        android:textColor="@color/budget_expense"
        android:textStyle="bold"
        android:gravity="end"
        android:minWidth="80dp" />

</LinearLayout>
