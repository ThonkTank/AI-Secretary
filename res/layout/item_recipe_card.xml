<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="160dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/margin_small">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surface_card"
        android:padding="@dimen/padding_medium">

        <!-- Titel + Favorit -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/recipe_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="Hähnchen mit Gemüse" />

            <ImageView
                android:id="@+id/recipe_favorite"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="@dimen/margin_small"
                android:src="@android:drawable/btn_star_big_off"
                android:contentDescription="@string/cd_favorite" />

        </LinearLayout>

        <!-- Meta: Zeit + Kalorien -->
        <TextView
            android:id="@+id/recipe_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:text="30 min • 450 kcal" />

        <!-- MealType Badge -->
        <TextView
            android:id="@+id/recipe_meal_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:textSize="10sp"
            android:textColor="@color/text_secondary"
            android:background="@color/surface_elevated"
            android:text="Mittagessen" />

        <!-- Tags -->
        <TextView
            android:id="@+id/recipe_tags"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            android:textSize="10sp"
            android:textColor="@color/text_tertiary"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="schnell, gesund"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>
