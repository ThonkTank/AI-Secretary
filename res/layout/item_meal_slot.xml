<?xml version="1.0" encoding="utf-8"?>
<!-- Meal-Slot Karte für Wochenplan (4 pro Tag: Frühstück, Mittag, Abend, Snack) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="80dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/margin_small">

    <LinearLayout
        android:id="@+id/meal_slot_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surface_card"
        android:padding="@dimen/padding_small"
        android:minHeight="72dp">

        <!-- Icon + Zeit -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/meal_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:text="" />

            <TextView
                android:id="@+id/meal_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:text="06:30" />

        </LinearLayout>

        <!-- Rezept-Titel oder "+ Hinzufügen" -->
        <TextView
            android:id="@+id/meal_recipe_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="11sp"
            android:textColor="@color/text_primary"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="Früchte-müsli" />

        <!-- Kalorien (nur wenn Rezept zugewiesen) -->
        <TextView
            android:id="@+id/meal_calories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="10sp"
            android:textColor="@color/text_tertiary"
            android:visibility="gone"
            android:text="450 kcal" />

    </LinearLayout>

</FrameLayout>
