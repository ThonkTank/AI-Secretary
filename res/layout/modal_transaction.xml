<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/modal_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_margin="@dimen/padding_large"
    android:orientation="vertical"
    android:background="@color/white"
    android:padding="@dimen/padding_medium"
    android:elevation="8dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Modal Title -->
            <TextView
                android:id="@+id/modal_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/title_new_transaction"
                android:textSize="@dimen/sp_heading"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="@dimen/padding_medium" />

            <!-- Type Toggle: Ausgabe / Einnahme -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_typ"
                android:textSize="@dimen/sp_caption"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/padding_medium">

                <TextView
                    android:id="@+id/btn_expense"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="@string/label_ausgabe"
                    android:textColor="@color/white"
                    android:background="@color/budget_expense"
                    android:gravity="center"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/btn_income"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="@string/label_einnahme"
                    android:textColor="@color/text_primary"
                    android:background="@color/button_inactive"
                    android:gravity="center"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <!-- Betrag -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_betrag_eur"
                android:textSize="@dimen/sp_caption"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/input_amount"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="@string/hint_amount_eur"
                android:inputType="numberDecimal"
                android:textSize="@dimen/sp_body"
                android:background="@color/surface"
                android:padding="@dimen/padding_small"
                android:layout_marginBottom="@dimen/padding_medium" />

            <!-- Konto -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_konto"
                android:textSize="@dimen/sp_caption"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/spinner_account"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@color/surface"
                android:padding="@dimen/padding_small"
                android:layout_marginBottom="@dimen/padding_medium"
                android:contentDescription="@string/cd_spinner_account" />

            <!-- Kategorie -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_kategorie"
                android:textSize="@dimen/sp_caption"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/spinner_category"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@color/surface"
                android:padding="@dimen/padding_small"
                android:layout_marginBottom="@dimen/padding_medium"
                android:contentDescription="@string/cd_spinner_category" />

            <!-- Datum -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_datum"
                android:textSize="@dimen/sp_caption"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/input_date"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="@string/hint_datum"
                android:textSize="@dimen/sp_body"
                android:background="@color/surface"
                android:padding="@dimen/padding_small"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/padding_medium" />

            <!-- Beschreibung -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_beschreibung_optional"
                android:textSize="@dimen/sp_caption"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/input_description"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="@string/hint_description_example"
                android:inputType="text"
                android:textSize="@dimen/sp_body"
                android:background="@color/surface"
                android:padding="@dimen/padding_small"
                android:layout_marginBottom="@dimen/padding_medium" />

            <!-- Empfaenger/Zahler -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_empfaenger_optional"
                android:textSize="@dimen/sp_caption"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/input_payee"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="@string/hint_payee_example"
                android:inputType="text"
                android:textSize="@dimen/sp_body"
                android:background="@color/surface"
                android:padding="@dimen/padding_small"
                android:layout_marginBottom="@dimen/padding_medium" />

            <!-- Error Text -->
            <TextView
                android:id="@+id/error_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_error"
                android:textSize="@dimen/sp_caption"
                android:visibility="gone"
                android:layout_marginBottom="@dimen/padding_small" />

        </LinearLayout>
    </ScrollView>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/padding_medium">

        <TextView
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/btn_cancel"
            android:textColor="@color/text_secondary"
            android:background="@color/button_inactive"
            android:gravity="center"
            android:layout_marginEnd="@dimen/padding_small" />

        <TextView
            android:id="@+id/btn_save"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/btn_save"
            android:textColor="@color/white"
            android:background="@color/accent"
            android:gravity="center"
            android:layout_marginStart="@dimen/padding_small" />
    </LinearLayout>

</LinearLayout>
