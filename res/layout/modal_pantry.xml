<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/overlay_dim">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surface_card"
        android:layout_margin="@dimen/margin_medium"
        android:layout_gravity="center"
        android:padding="@dimen/padding_medium"
        android:clickable="true">

        <!-- Title -->
        <TextView
            android:id="@+id/modal_pantry_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_add_pantry"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="@dimen/margin_medium" />

        <!-- Zutat -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_zutat"
            android:textSize="12sp"
            android:textColor="@color/text_secondary" />

        <Spinner
            android:id="@+id/spinner_pantry_ingredient"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@color/surface"
            android:padding="@dimen/padding_small"
            android:contentDescription="@string/cd_spinner_ingredient" />

        <!-- Menge + Einheit -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/margin_small">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:orientation="vertical"
                android:layout_marginEnd="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_menge"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary" />

                <EditText
                    android:id="@+id/input_pantry_amount"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@color/surface"
                    android:padding="@dimen/padding_small"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:hint="@string/hint_amount_example"
                    android:inputType="numberDecimal" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_einheit"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/pantry_unit_label"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@color/surface"
                    android:padding="@dimen/padding_small"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:gravity="center_vertical"
                    android:text="g" />

            </LinearLayout>

        </LinearLayout>

        <!-- Lagerort -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_lagerort"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="@dimen/margin_small" />

        <Spinner
            android:id="@+id/spinner_pantry_location"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@color/surface"
            android:padding="@dimen/padding_small"
            android:contentDescription="@string/cd_spinner_location" />

        <!-- Ablaufdatum -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_ablaufdatum"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="@dimen/margin_small" />

        <TextView
            android:id="@+id/input_pantry_expiry"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@color/surface"
            android:padding="@dimen/padding_small"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:gravity="center_vertical"
            android:hint="@string/hint_select_date"
            android:clickable="true"
            android:focusable="true" />

        <!-- Button Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/margin_medium"
            android:gravity="end">

            <TextView
                android:id="@+id/btn_pantry_delete"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center"
                android:paddingHorizontal="@dimen/padding_medium"
                android:text="@string/btn_delete"
                android:textSize="14sp"
                android:textColor="@color/error"
                android:visibility="gone" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btn_pantry_cancel"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center"
                android:paddingHorizontal="@dimen/padding_medium"
                android:text="@string/btn_cancel"
                android:textSize="14sp"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/btn_pantry_save"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center"
                android:paddingHorizontal="@dimen/padding_medium"
                android:text="@string/btn_save"
                android:textSize="14sp"
                android:textColor="@color/accent"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
