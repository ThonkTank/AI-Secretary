<?xml version="1.0" encoding="utf-8"?>
<!-- item_calendar.xml - Einheitliches Kalender-Event-Layout für App und Widget (RemoteViews-kompatibel) -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/calendar_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/card_padding_h"
    android:paddingEnd="@dimen/card_padding_h"
    android:paddingTop="@dimen/card_padding_v"
    android:paddingBottom="@dimen/card_padding_v"
    android:background="@color/calendar_event_bg">

    <!-- Zeit-Container (links, vertikal: Start oben, Ende unten) -->
    <LinearLayout
        android:id="@+id/calendar_time_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/calendar_time_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/sp_small"
            android:textColor="@color/accent" />

        <TextView
            android:id="@+id/calendar_time_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/sp_small"
            android:textColor="@color/accent" />

    </LinearLayout>

    <!-- Farbbalken (Accent) - ImageView statt View für RemoteViews-Kompatibilität -->
    <ImageView
        android:id="@+id/calendar_color_bar"
        android:layout_width="@dimen/goal_bar_width"
        android:layout_height="match_parent"
        android:layout_toEndOf="@id/calendar_time_container"
        android:layout_marginStart="@dimen/padding_small"
        android:background="@color/accent"
        android:contentDescription="@null" />

    <!-- Titel -->
    <TextView
        android:id="@+id/calendar_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/calendar_color_bar"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/padding_small"
        android:textSize="@dimen/sp_body"
        android:textColor="@color/accent" />

</RelativeLayout>
