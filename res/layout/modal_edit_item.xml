<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/overlay_dim">

    <!-- Modal-Card (clickable verhindert Durchfallen zum Overlay) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="32dp"
        android:background="@android:color/white"
        android:elevation="8dp"
        android:orientation="vertical"
        android:clickable="true">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/padding_large">

                <!-- Typ-Auswahl -->
                <TextView style="@style/FormLabel" android:text="@string/label_typ" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <Button android:id="@+id/btn_type_task" style="@style/GroupButton"
                        android:text="TASK" android:textSize="@dimen/sp_badge"
                        android:contentDescription="@string/cd_type_task" />
                    <Button android:id="@+id/btn_type_goal" style="@style/GroupButton"
                        android:text="GOAL" android:textSize="@dimen/sp_badge"
                        android:contentDescription="@string/cd_type_goal" />
                    <Button android:id="@+id/btn_type_project" style="@style/GroupButton"
                        android:text="PROJECT" android:textSize="@dimen/sp_badge"
                        android:contentDescription="@string/cd_type_project" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="8dp"
                    android:importantForAccessibility="no" />

                <!-- Titel -->
                <TextView style="@style/FormLabel" android:text="@string/label_titel" />
                <EditText
                    android:id="@+id/field_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_item_title"
                    android:singleLine="true"
                    android:textSize="@dimen/sp_body" />

                <!-- Beschreibung -->
                <TextView style="@style/FormLabel" android:text="@string/label_beschreibung" />
                <EditText
                    android:id="@+id/field_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_description_optional"
                    android:maxLines="3"
                    android:textSize="@dimen/sp_body" />

                <!-- Icon (nur GOAL) -->
                <LinearLayout
                    android:id="@+id/row_goal_icon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <TextView style="@style/FormLabel" android:text="@string/label_icon" />
                    <EditText
                        android:id="@+id/field_goal_icon"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_emoji"
                        android:singleLine="true"
                        android:textSize="@dimen/sp_heading" />
                </LinearLayout>

                <!-- Farbe (nur GOAL) -->
                <LinearLayout
                    android:id="@+id/row_goal_color"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <TextView style="@style/FormLabel" android:text="@string/label_farbe" />
                    <LinearLayout
                        android:id="@+id/color_grid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp">
                        <!-- Farb-Buttons werden programmatisch erzeugt -->
                    </LinearLayout>
                </LinearLayout>

                <!-- Min Dauer -->
                <LinearLayout
                    android:id="@+id/row_min_duration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <TextView style="@style/FormLabel" android:text="@string/label_min_dauer" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <EditText
                            android:id="@+id/field_min_duration"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:inputType="number"
                            android:hint="Wert"
                            android:singleLine="true"
                            android:textSize="@dimen/sp_body" />
                        <Button android:id="@+id/btn_min_unit_minutes" style="@style/GroupButton"
                            android:text="MIN" android:textSize="10sp"
                            android:contentDescription="@string/cd_unit_minutes" />
                        <Button android:id="@+id/btn_min_unit_progress" style="@style/GroupButton"
                            android:text="EINH" android:textSize="10sp"
                            android:contentDescription="@string/cd_unit_progress" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Max Dauer -->
                <LinearLayout
                    android:id="@+id/row_duration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView style="@style/FormLabel" android:text="@string/label_max_dauer" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <EditText
                            android:id="@+id/field_duration"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:inputType="number"
                            android:hint="Wert"
                            android:singleLine="true"
                            android:textSize="@dimen/sp_body" />
                        <Button android:id="@+id/btn_max_unit_minutes" style="@style/GroupButton"
                            android:text="MIN" android:textSize="10sp"
                            android:contentDescription="@string/cd_unit_minutes" />
                        <Button android:id="@+id/btn_max_unit_progress" style="@style/GroupButton"
                            android:text="EINH" android:textSize="10sp"
                            android:contentDescription="@string/cd_unit_progress" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Prioritaet -->
                <TextView style="@style/FormLabel" android:text="@string/label_prioritaet" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <Button android:id="@+id/btn_prio_low" style="@style/GroupButton"
                        android:text="L" android:textSize="@dimen/sp_small"
                        android:contentDescription="@string/cd_prio_low" />
                    <Button android:id="@+id/btn_prio_moderate" style="@style/GroupButton"
                        android:text="M" android:textSize="@dimen/sp_small"
                        android:contentDescription="@string/cd_prio_moderate" />
                    <Button android:id="@+id/btn_prio_high" style="@style/GroupButton"
                        android:text="H" android:textSize="@dimen/sp_small"
                        android:contentDescription="@string/cd_prio_high" />
                    <Button android:id="@+id/btn_prio_critical" style="@style/GroupButton"
                        android:text="C" android:textSize="@dimen/sp_small"
                        android:contentDescription="@string/cd_prio_critical" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="8dp"
                    android:importantForAccessibility="no" />

                <!-- Parent -->
                <LinearLayout
                    android:id="@+id/row_parent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView style="@style/FormLabel" android:text="@string/label_parent" />
                    <Spinner
                        android:id="@+id/spinner_parent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/cd_spinner_parent" />
                </LinearLayout>

                <!-- Vorgänger (nur TASK) -->
                <LinearLayout
                    android:id="@+id/row_predecessor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <TextView style="@style/FormLabel" android:text="@string/label_nach_task" />
                    <Spinner
                        android:id="@+id/spinner_predecessor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/cd_spinner_predecessor" />
                </LinearLayout>

                <!-- Wartezeit nach Vorgänger (nur wenn Vorgänger gewählt) -->
                <LinearLayout
                    android:id="@+id/row_predecessor_delay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <TextView style="@style/FormLabel" android:text="@string/label_wartezeit_minuten" />
                    <EditText
                        android:id="@+id/field_predecessor_delay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:hint="@string/hint_delay_zero"
                        android:singleLine="true"
                        android:textSize="@dimen/sp_body" />
                </LinearLayout>

                <!-- Bevorzugte Uhrzeit (nur TASK) -->
                <LinearLayout
                    android:id="@+id/row_pref_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <TextView style="@style/FormLabel" android:text="@string/label_bevorzugte_uhrzeit" />
                    <EditText
                        android:id="@+id/field_pref_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_uhrzeit"
                        android:focusable="false"
                        android:clickable="true"
                        android:textSize="@dimen/sp_body" />
                </LinearLayout>

                <!-- Cooldown -->
                <LinearLayout
                    android:id="@+id/row_cooldown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView style="@style/FormLabel" android:text="@string/label_cooldown_tage" />
                    <EditText
                        android:id="@+id/field_cooldown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:hint="@string/hint_cooldown_days"
                        android:singleLine="true"
                        android:textSize="@dimen/sp_body" />
                </LinearLayout>

                <!-- Deadline -->
                <LinearLayout
                    android:id="@+id/row_deadline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView style="@style/FormLabel" android:text="@string/label_deadline" />
                    <EditText
                        android:id="@+id/field_deadline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_datum"
                        android:focusable="false"
                        android:clickable="true"
                        android:textSize="@dimen/sp_body" />
                </LinearLayout>

                <!-- Fester Termin - Datum (nur TASK + NONE) -->
                <LinearLayout
                    android:id="@+id/row_fixed_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView style="@style/FormLabel" android:text="@string/label_fester_termin_datum" />
                    <EditText
                        android:id="@+id/field_fixed_date"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_datum"
                        android:focusable="false"
                        android:clickable="true"
                        android:textSize="@dimen/sp_body" />
                </LinearLayout>

                <!-- Fester Termin - Uhrzeit (nur TASK + NONE) -->
                <LinearLayout
                    android:id="@+id/row_fixed_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView style="@style/FormLabel" android:text="@string/label_fester_termin_uhrzeit" />
                    <EditText
                        android:id="@+id/field_fixed_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_uhrzeit"
                        android:focusable="false"
                        android:clickable="true"
                        android:textSize="@dimen/sp_body" />
                </LinearLayout>

                <!-- Budget-Anforderung (nur TASK) -->
                <LinearLayout
                    android:id="@+id/row_budget"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <TextView style="@style/FormLabel" android:text="@string/label_budget_eur" />
                    <EditText
                        android:id="@+id/field_budget_amount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:hint="0.00"
                        android:singleLine="true"
                        android:textSize="@dimen/sp_body" />
                </LinearLayout>

                <!-- Budget-Konto (nur TASK) -->
                <LinearLayout
                    android:id="@+id/row_budget_account"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <TextView style="@style/FormLabel" android:text="@string/label_konto" />
                    <Spinner
                        android:id="@+id/spinner_budget_account"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/cd_spinner_budget_account" />
                </LinearLayout>

                <!-- Budget-Kategorie (nur TASK) -->
                <LinearLayout
                    android:id="@+id/row_budget_category"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <TextView style="@style/FormLabel" android:text="@string/label_kategorie" />
                    <Spinner
                        android:id="@+id/spinner_budget_category"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/cd_spinner_budget_category" />
                </LinearLayout>

                <!-- Fortschritt -->
                <LinearLayout
                    android:id="@+id/row_progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView style="@style/FormLabel" android:text="@string/label_fortschritt" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <EditText
                            android:id="@+id/field_progress_current"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="@string/hint_progress_current"
                            android:inputType="number"
                            android:singleLine="true"
                            android:textSize="@dimen/sp_body" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:text="/"
                            android:textSize="@dimen/sp_body" />
                        <EditText
                            android:id="@+id/field_progress_target"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="@string/hint_progress_target"
                            android:inputType="number"
                            android:singleLine="true"
                            android:textSize="@dimen/sp_body" />
                    </LinearLayout>
                    <EditText
                        android:id="@+id/field_progress_unit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_progress_unit"
                        android:singleLine="true"
                        android:textSize="@dimen/sp_body" />
                </LinearLayout>

                <!-- Progress pro Periode -->
                <LinearLayout
                    android:id="@+id/row_progress_per_rep"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:paddingVertical="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_progress_per_rep"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/sp_body" />

                    <Button
                        android:id="@+id/btn_progress_per_rep"
                        style="@style/GroupButton"
                        android:layout_width="60dp"
                        android:text="@string/btn_toggle_off"
                        android:contentDescription="@string/cd_toggle_progress_per_rep" />
                </LinearLayout>

                <!-- Wiederholung-Sektion -->
                <LinearLayout
                    android:id="@+id/section_repetition"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView style="@style/FormLabel" android:text="@string/label_wiederholung" />

                    <!-- RepType Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <Button android:id="@+id/btn_rep_none" style="@style/GroupButton"
                            android:text="KEINE" android:textSize="10sp"
                            android:contentDescription="@string/cd_rep_none" />
                        <Button android:id="@+id/btn_rep_interval" style="@style/GroupButton"
                            android:text="INTERVAL" android:textSize="10sp"
                            android:contentDescription="@string/cd_rep_interval" />
                        <Button android:id="@+id/btn_rep_reps" style="@style/GroupButton"
                            android:text="REPS" android:textSize="10sp"
                            android:contentDescription="@string/cd_rep_reps" />
                        <Button android:id="@+id/btn_rep_day_of" style="@style/GroupButton"
                            android:text="DAY_OF" android:textSize="10sp"
                            android:contentDescription="@string/cd_rep_day_of" />
                    </LinearLayout>

                    <!-- Detail-Felder (ausgeblendet bei KEINE) -->
                    <LinearLayout
                        android:id="@+id/section_rep_details"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Wert -->
                        <TextView style="@style/FormLabel" android:text="@string/label_wert" />
                        <EditText
                            android:id="@+id/field_rep_value"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:hint="@string/hint_rep_value"
                            android:singleLine="true"
                            android:textSize="@dimen/sp_body" />

                        <!-- Einheit Buttons -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <Button android:id="@+id/btn_unit_day" style="@style/GroupButton"
                                android:text="TAG" android:textSize="10sp"
                                android:contentDescription="@string/cd_unit_day" />
                            <Button android:id="@+id/btn_unit_week" style="@style/GroupButton"
                                android:text="WOCHE" android:textSize="10sp"
                                android:contentDescription="@string/cd_unit_week" />
                            <Button android:id="@+id/btn_unit_month" style="@style/GroupButton"
                                android:text="MONAT" android:textSize="10sp"
                                android:contentDescription="@string/cd_unit_month" />
                        </LinearLayout>

                        <!-- Wochentag (nur bei DAY_OF_TIME + WEEK) -->
                        <LinearLayout
                            android:id="@+id/row_weekday"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView style="@style/FormLabel" android:text="@string/label_wochentag" />
                            <Spinner
                                android:id="@+id/spinner_weekday"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:contentDescription="@string/cd_spinner_weekday" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Erst erledigen vor Reset (nur TASK) -->
                <LinearLayout
                    android:id="@+id/row_complete_first"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:paddingVertical="8dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_complete_first"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/sp_body" />
                    <Button
                        android:id="@+id/btn_complete_first"
                        style="@style/GroupButton"
                        android:layout_width="60dp"
                        android:text="@string/btn_toggle_off"
                        android:contentDescription="@string/cd_toggle_complete_first" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="12dp"
                    android:importantForAccessibility="no" />

                <!-- Fehler-Text -->
                <TextView
                    android:id="@+id/text_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_error"
                    android:textSize="@dimen/sp_small"
                    android:visibility="gone" />
                <View android:layout_width="match_parent" android:layout_height="8dp" />

                <!-- Speichern -->
                <Button
                    android:id="@+id/btn_save"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_save"
                    android:textColor="@android:color/white" />
                <View android:layout_width="match_parent" android:layout_height="8dp" />

                <!-- Abbrechen -->
                <Button
                    android:id="@+id/btn_cancel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_cancel" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
