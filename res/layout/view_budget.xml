<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Hauptinhalt -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/budget_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/padding_medium">

            <!-- Summary Card -->
            <LinearLayout
                android:id="@+id/summary_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/card_background"
                android:padding="@dimen/padding_medium"
                android:layout_marginBottom="@dimen/padding_medium"
                android:elevation="2dp">

                <TextView
                    android:id="@+id/total_balance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/sp_heading"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:gravity="center"
                    android:text="0,00 EUR" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/sp_caption"
                    android:textColor="@color/text_secondary"
                    android:gravity="center"
                    android:text="Gesamtsaldo"
                    android:layout_marginBottom="@dimen/padding_small" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/padding_small">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/monthly_income"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/sp_body"
                            android:textColor="@color/budget_income"
                            android:textStyle="bold"
                            android:text="+0,00" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/sp_caption"
                            android:textColor="@color/text_secondary"
                            android:text="Einnahmen" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/monthly_expenses"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/sp_body"
                            android:textColor="@color/budget_expense"
                            android:textStyle="bold"
                            android:text="-0,00" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/sp_caption"
                            android:textColor="@color/text_secondary"
                            android:text="Ausgaben" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/monthly_net"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/sp_body"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"
                            android:text="0,00" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/sp_caption"
                            android:textColor="@color/text_secondary"
                            android:text="Netto" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Section: Konten -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Konten"
                android:textSize="@dimen/sp_subhead"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="@dimen/padding_small" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="@dimen/padding_medium">

                <LinearLayout
                    android:id="@+id/accounts_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- AccountCards werden programmatisch eingefuegt -->

                </LinearLayout>
            </HorizontalScrollView>

            <!-- Section: Budget -->
            <TextView
                android:id="@+id/budget_section_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Budget"
                android:textSize="@dimen/sp_subhead"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="@dimen/padding_small" />

            <LinearLayout
                android:id="@+id/budget_bars_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="@dimen/padding_medium">

                <!-- BudgetBars werden programmatisch eingefuegt -->

            </LinearLayout>

            <!-- Section: Letzte Transaktionen -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Letzte Transaktionen"
                android:textSize="@dimen/sp_subhead"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="@dimen/padding_small" />

            <LinearLayout
                android:id="@+id/transactions_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- TransactionRows werden programmatisch eingefuegt -->

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- FAB Container -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/padding_medium"
        android:layout_marginBottom="@dimen/padding_medium"
        android:orientation="vertical">

        <!-- FAB: Import -->
        <FrameLayout
            android:id="@+id/fab_import"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="@dimen/padding_small"
            android:background="@color/button_inactive"
            android:elevation="4dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="📥"
                android:textSize="20sp"
                android:gravity="center" />
        </FrameLayout>

        <!-- FAB: Neue Transaktion -->
        <FrameLayout
            android:id="@+id/fab_add_transaction"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@color/accent"
            android:elevation="6dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="+"
                android:textSize="24sp"
                android:textColor="@color/white"
                android:gravity="center" />
        </FrameLayout>

    </LinearLayout>

    <!-- Modal Overlay: Transaction (initial GONE) -->
    <FrameLayout
        android:id="@+id/modal_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/overlay_dim"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <include layout="@layout/modal_transaction" />

    </FrameLayout>

    <!-- Modal Overlay: Import (initial GONE) -->
    <FrameLayout
        android:id="@+id/import_modal_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/overlay_dim"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <include layout="@layout/modal_import" />

    </FrameLayout>

    <!-- Modal Overlay: Recurring Suggestions (initial GONE) -->
    <FrameLayout
        android:id="@+id/recurring_modal_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/overlay_dim"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <include layout="@layout/modal_recurring_suggestions" />

    </FrameLayout>

</FrameLayout>
