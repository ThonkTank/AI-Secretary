<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/card_background"
    android:padding="@dimen/padding_small"
    android:layout_marginBottom="@dimen/padding_tiny"
    android:elevation="1dp">

    <!-- Left: Checkbox + Name -->
    <LinearLayout
        android:id="@+id/shopping_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_toStartOf="@+id/shopping_amount"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Checkbox (ImageView fuer Widget-Kompatibilitaet) -->
        <ImageView
            android:id="@+id/shopping_checkbox"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/checkbox_off_background"
            android:layout_marginEnd="@dimen/padding_small"
            android:contentDescription="@string/cd_checked" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/shopping_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Zutat"
                android:textSize="@dimen/sp_body"
                android:textColor="@color/text_primary"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/shopping_excess"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="(+50g Ueberschuss)"
                android:textSize="@dimen/sp_caption"
                android:textColor="@color/text_tertiary"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Right: Menge -->
    <TextView
        android:id="@+id/shopping_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:text="500 g"
        android:textSize="@dimen/sp_body"
        android:textColor="@color/text_secondary"
        android:layout_marginStart="@dimen/padding_small" />

</RelativeLayout>
