<?xml version="1.0" encoding="utf-8"?>
<!-- Day picker button background color states: disabled → checked → default.

     Used by Widget.AutoSecretary.TaskEdit.DayPickerButton.

     Color scheme references shared palette in colors.xml. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/color_primary_disabled_8" />
    <item android:state_checked="true" android:color="@color/color_primary" />
    <item android:color="@color/transparent" />
</selector>
