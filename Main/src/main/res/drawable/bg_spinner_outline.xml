<?xml version="1.0" encoding="utf-8"?>
<!-- Inset rounded field background for selector/spinner inputs across all features.
     Applied via Widget.AutoSecretary.Editor.Spinner style in styles.xml. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetTop="@dimen/spacing_xs"
    android:insetBottom="@dimen/spacing_xs">
    <shape android:shape="rectangle">
        <solid android:color="@color/color_surface" />
        <stroke
            android:width="1dp"
            android:color="@color/color_outline" />
        <corners android:radius="@dimen/corner_radius_sm" />
    </shape>
</inset>
