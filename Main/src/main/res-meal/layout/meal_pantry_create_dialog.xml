<?xml version="1.0" encoding="utf-8"?>
<!-- Add pantry item dialog. Managed by MealPlannerFragment.
     MealPantryLocation spinner items are populated programmatically by MealPlannerFragment
     from the pantry-location enum (e.g. Fridge, Freezer, Shelf). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/spacing_lg">

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.AutoSecretary.Editor.TextFieldLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/meal_label_name">

        <com.google.android.material.textfield.TextInputEditText
            style="@style/Widget.AutoSecretary.Editor.TextField"
            android:id="@+id/MealPantryName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.AutoSecretary.Editor.TextFieldLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:hint="@string/meal_label_amount">

        <com.google.android.material.textfield.TextInputEditText
            style="@style/Widget.AutoSecretary.Editor.TextField"
            android:id="@+id/MealPantryAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.AutoSecretary.Editor.TextFieldLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:hint="@string/meal_label_unit">

        <com.google.android.material.textfield.TextInputEditText
            style="@style/Widget.AutoSecretary.Editor.TextField"
            android:id="@+id/MealPantryUnit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.AutoSecretary.Editor.TextFieldLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:hint="@string/meal_label_shelf_life_days">

        <com.google.android.material.textfield.TextInputEditText
            style="@style/Widget.AutoSecretary.Editor.TextField"
            android:id="@+id/MealPantryShelfLifeDays"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:text="@string/meal_label_location"
        android:textAppearance="@style/TextAppearance.AutoSecretary.Editor.Label"
        android:labelFor="@id/MealPantryLocation" />

    <Spinner
        android:id="@+id/MealPantryLocation"
        style="@style/Widget.AutoSecretary.Editor.Spinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs" />
</LinearLayout>
