<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Global rule: app-wide tokens stay in generic files; feature-specific resources belong in feature-prefixed files.
         Budget color groups:
         - Semantic status: budget_positive (green), budget_negative (red), budget_warning (orange), budget_neutral (grey)
           Used for transaction amounts, balance indicators, and status text.
         - Chart: budget_chart_line, budget_chart_axis, budget_chart_label
           Used by BudgetBalanceChartView for the balance timeline chart.
         - UI: budget_divider (list dividers in budget overview)
         - Widget: budget_widget_header_text, budget_widget_card_text (home-screen widget text)
         Naming: budget_[domain]_[role] — see colors.xml header for full naming conventions.
         For new colors, use semantic names that describe purpose, not appearance. -->

    <!-- Semantic status colors — aliased to app-wide nature palette for visual cohesion. -->
    <color name="budget_positive">@color/color_primary</color>
    <color name="budget_negative">@color/color_negative</color>
    <color name="budget_warning">@color/color_accent</color>
    <color name="budget_neutral">@color/color_on_surface_muted</color>
    <!-- Chart and widget tokens alias app-wide palette from colors.xml. -->
    <color name="budget_chart_line">@color/color_primary</color>
    <color name="budget_chart_axis">@color/color_outline</color>
    <color name="budget_chart_label">@color/color_on_surface_muted</color>
    <color name="budget_divider">@color/color_outline</color>

    <!-- Widget semantic tokens -->
    <color name="budget_widget_header_text">@color/color_on_surface</color>
    <color name="budget_widget_card_text">@color/color_on_surface</color>
</resources>
