{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ThonkTank/AI-Secretary/release-metadata.schema.json",
  "title": "Auto Secretary phone release metadata",
  "type": "object",
  "required": [
    "schemaVersion",
    "versionCode",
    "versionName",
    "packageName",
    "apkAsset",
    "apkSizeBytes",
    "sha256",
    "signerSha256",
    "commitSha"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "versionCode": { "type": "integer", "minimum": 1, "maximum": 2100000000 },
    "versionName": { "type": "string", "minLength": 1 },
    "packageName": { "const": "com.autosecretary" },
    "apkAsset": { "const": "AutoSecretary.apk" },
    "apkSizeBytes": { "type": "integer", "minimum": 1, "maximum": 83886080 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "signerSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
  },
  "additionalProperties": false
}
