<?xml version="1.0" encoding="utf-8"?>
<!-- Pantry inventory row. Shows location icon + name + amount + expiry info. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_row"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="@dimen/row_min_height"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/spacing_lg"
    android:paddingVertical="@dimen/spacing_sm"
    android:layout_marginBottom="@dimen/spacing_xs">

    <TextView
        android:id="@+id/MealPantryRowIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:textSize="20sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/spacing_sm"
        android:orientation="vertical">

        <TextView
            android:id="@+id/MealPantryRowTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.AutoSecretary.Meal.RowTitle" />

        <TextView
            android:id="@+id/MealPantryRowSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.AutoSecretary.Meal.RowSubtitle" />
    </LinearLayout>
</LinearLayout>
