<?xml version="1.0" encoding="utf-8"?>
<!-- Create / edit household member dialog. Managed by MealHouseholdDialogController. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_lg">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.AutoSecretary.Editor.TextFieldLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/meal_household_label_name">

            <com.google.android.material.textfield.TextInputEditText
                style="@style/Widget.AutoSecretary.Editor.TextField"
                android:id="@+id/MealHouseholdName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.AutoSecretary.Editor.TextFieldLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:hint="@string/meal_household_label_birth_year">

            <com.google.android.material.textfield.TextInputEditText
                style="@style/Widget.AutoSecretary.Editor.TextField"
                android:id="@+id/MealHouseholdBirthYear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Gender spinner -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/meal_household_label_gender"
            android:textAppearance="@style/TextAppearance.AutoSecretary.Editor.Label"
            android:labelFor="@id/MealHouseholdGender" />

        <Spinner
            android:id="@+id/MealHouseholdGender"
            style="@style/Widget.AutoSecretary.Editor.Spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs" />

        <!-- Weight + Height -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.AutoSecretary.Editor.TextFieldLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/meal_household_label_weight">

                <com.google.android.material.textfield.TextInputEditText
                    style="@style/Widget.AutoSecretary.Editor.TextField"
                    android:id="@+id/MealHouseholdWeight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.AutoSecretary.Editor.TextFieldLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_sm"
                android:hint="@string/meal_household_label_height">

                <com.google.android.material.textfield.TextInputEditText
                    style="@style/Widget.AutoSecretary.Editor.TextField"
                    android:id="@+id/MealHouseholdHeight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Activity level spinner -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/meal_household_label_activity"
            android:textAppearance="@style/TextAppearance.AutoSecretary.Editor.Label"
            android:labelFor="@id/MealHouseholdActivity" />

        <Spinner
            android:id="@+id/MealHouseholdActivity"
            style="@style/Widget.AutoSecretary.Editor.Spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs" />

        <!-- Active checkbox -->
        <CheckBox
            android:id="@+id/MealHouseholdActive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/meal_household_label_active"
            android:checked="true" />
    </LinearLayout>
</ScrollView>
