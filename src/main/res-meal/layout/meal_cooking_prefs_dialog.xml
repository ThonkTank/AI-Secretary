<?xml version="1.0" encoding="utf-8"?>
<!-- Cooking preferences dialog. Per-MealType max cooking sessions + quick prep threshold. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_lg">

        <!-- Breakfast -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/meal_cooking_prefs_breakfast"
            android:textAppearance="@style/TextAppearance.AutoSecretary.Editor.Label" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.AutoSecretary.Editor.TextFieldLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:hint="@string/meal_cooking_prefs_max_per_week">

            <com.google.android.material.textfield.TextInputEditText
                style="@style/Widget.AutoSecretary.Editor.TextField"
                android:id="@+id/MealCookingPrefsBreakfastMax"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Lunch -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/meal_cooking_prefs_lunch"
            android:textAppearance="@style/TextAppearance.AutoSecretary.Editor.Label" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.AutoSecretary.Editor.TextFieldLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:hint="@string/meal_cooking_prefs_max_per_week">

            <com.google.android.material.textfield.TextInputEditText
                style="@style/Widget.AutoSecretary.Editor.TextField"
                android:id="@+id/MealCookingPrefsLunchMax"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Dinner -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/meal_cooking_prefs_dinner"
            android:textAppearance="@style/TextAppearance.AutoSecretary.Editor.Label" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.AutoSecretary.Editor.TextFieldLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:hint="@string/meal_cooking_prefs_max_per_week">

            <com.google.android.material.textfield.TextInputEditText
                style="@style/Widget.AutoSecretary.Editor.TextField"
                android:id="@+id/MealCookingPrefsDinnerMax"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Snack -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/meal_cooking_prefs_snack"
            android:textAppearance="@style/TextAppearance.AutoSecretary.Editor.Label" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.AutoSecretary.Editor.TextFieldLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:hint="@string/meal_cooking_prefs_max_per_week">

            <com.google.android.material.textfield.TextInputEditText
                style="@style/Widget.AutoSecretary.Editor.TextField"
                android:id="@+id/MealCookingPrefsSnackMax"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Quick prep threshold -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.AutoSecretary.Editor.TextFieldLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:hint="@string/meal_cooking_prefs_quick_prep">

            <com.google.android.material.textfield.TextInputEditText
                style="@style/Widget.AutoSecretary.Editor.TextField"
                android:id="@+id/MealCookingPrefsQuickPrep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
</ScrollView>
