<?xml version="1.0" encoding="utf-8"?>
<!-- Row item for household member list. Shows name + info summary. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_row"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="@dimen/row_min_height"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/spacing_lg"
    android:paddingVertical="@dimen/spacing_sm"
    android:layout_marginBottom="@dimen/spacing_xs">

    <TextView
        android:id="@+id/MealHouseholdRowTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.AutoSecretary.Meal.RowTitle" />

    <TextView
        android:id="@+id/MealHouseholdRowSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.AutoSecretary.Meal.RowSubtitle" />
</LinearLayout>
