<?xml version="1.0" encoding="utf-8"?>
<!-- Week plan, recipes, and stock sections are stacked in one ScrollView.
     Lists (MealWeekList, MealRecipeList, MealPantryList, MealShoppingList) are
     LinearLayouts with items inflated programmatically by MealPlannerPresenter. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_lg">

        <!-- Week view -->
        <LinearLayout
            android:id="@+id/MealWeekScreen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/meal_week_title"
                android:textAppearance="@style/TextAppearance.AutoSecretary.SectionTitle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/MealAddPlan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/meal_add_plan" />

            <include
                layout="@layout/include_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm" />

            <LinearLayout
                android:id="@+id/MealWeekList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Recipes view -->
        <LinearLayout
            android:id="@+id/MealRecipeScreen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/meal_recipe_title"
                android:textAppearance="@style/TextAppearance.AutoSecretary.SectionTitle" />

            <include
                layout="@layout/include_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm" />

            <LinearLayout
                android:id="@+id/MealRecipeList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/MealRecipeDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:background="@drawable/bg_row"
                android:padding="@dimen/spacing_md"
                android:text="@string/meal_recipe_detail_placeholder"
                android:textAppearance="@style/TextAppearance.AutoSecretary.Meal.RowBody" />
        </LinearLayout>

        <!-- Stock / Pantry view -->
        <LinearLayout
            android:id="@+id/MealStockScreen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/meal_stock_title"
                android:textAppearance="@style/TextAppearance.AutoSecretary.SectionTitle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/MealAddNeed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/meal_add_need" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/MealAddPantry"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:text="@string/meal_add_pantry" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/meal_pantry_title"
                android:textAppearance="@style/TextAppearance.AutoSecretary.SectionTitle" />

            <LinearLayout
                android:id="@+id/MealPantryList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:orientation="vertical" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/meal_shopping_title"
                android:textAppearance="@style/TextAppearance.AutoSecretary.SectionTitle" />

            <LinearLayout
                android:id="@+id/MealShoppingList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:orientation="vertical" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
