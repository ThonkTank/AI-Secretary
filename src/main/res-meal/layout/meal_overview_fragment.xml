<?xml version="1.0" encoding="utf-8"?>
<!-- One-page meal dashboard with three primary sections:
     1) Week plan, 2) Need progress, 3) Shopping list.
     Secondary actions stay available as quick actions without separate main pages. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_lg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_surface_card"
            android:padding="@dimen/spacing_md"
            android:layout_marginBottom="@dimen/spacing_md">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/meal_secondary_actions_title"
                android:textAppearance="@style/TextAppearance.AutoSecretary.SectionTitle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/MealActionRecipes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/meal_action_recipes" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/MealActionMembers"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:text="@string/meal_action_members" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/MealAddPantry"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/meal_action_stock" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/MealActionIngredients"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:text="@string/meal_action_ingredients" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/MealWeekSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_surface_card"
            android:padding="@dimen/spacing_md"
            android:layout_marginBottom="@dimen/spacing_md">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/meal_dashboard_week_title"
                android:textAppearance="@style/TextAppearance.AutoSecretary.SectionTitle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/MealAddPlan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/meal_add_plan" />

            <include
                layout="@layout/include_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm" />

            <LinearLayout
                android:id="@+id/MealWeekList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:orientation="vertical" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/MealNeedProgressSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_surface_card"
            android:padding="@dimen/spacing_md"
            android:layout_marginBottom="@dimen/spacing_md">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/meal_dashboard_progress_title"
                android:textAppearance="@style/TextAppearance.AutoSecretary.SectionTitle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/MealAddNeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/meal_add_need" />

            <TextView
                android:id="@+id/MealCalorieProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:textAppearance="@style/TextAppearance.AutoSecretary.Meal.RowBody" />

            <LinearLayout
                android:id="@+id/MealNeedProgressList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:orientation="vertical" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/MealShoppingSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_surface_card"
            android:padding="@dimen/spacing_md">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/meal_dashboard_shopping_title"
                android:textAppearance="@style/TextAppearance.AutoSecretary.SectionTitle" />

            <TextView
                android:id="@+id/MealShoppingOpenTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/meal_shopping_open"
                android:textAppearance="@style/TextAppearance.AutoSecretary.Meal.RowTitle" />

            <LinearLayout
                android:id="@+id/MealShoppingOpenList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/MealShoppingDoneTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/meal_shopping_done"
                android:textAppearance="@style/TextAppearance.AutoSecretary.Meal.RowTitle" />

            <LinearLayout
                android:id="@+id/MealShoppingDoneList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:orientation="vertical" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
