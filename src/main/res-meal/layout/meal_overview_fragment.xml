<?xml version="1.0" encoding="utf-8"?>
<!-- Two-mode meal screen: Übersicht (dashboard) and Verwalten (filtered management list).
     Mode toggle at top; Spinner selects entity type in Verwalten mode.
     Progress section scrolls with content (inside ScrollView) for both modes.
     MealPlannerFragment drives content + visibility. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/spacing_lg">

    <!-- Controls card: mode toggle + filter spinner (fixed above scroll) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_surface_card"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_md"
        android:paddingVertical="@dimen/spacing_sm"
        android:layout_marginBottom="@dimen/spacing_md">

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/MealModeToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:checkedButton="@id/MealModeOverview">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/MealModeOverview"
                style="@style/Widget.AutoSecretary.ToggleButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/meal_mode_overview"
                android:contentDescription="@string/meal_mode_overview_desc" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/MealModeManage"
                style="@style/Widget.AutoSecretary.ToggleButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/meal_mode_manage"
                android:contentDescription="@string/meal_mode_manage_desc" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <Spinner
            android:id="@+id/MealManageFilterSpinner"
            style="@style/Widget.AutoSecretary.Editor.Spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Scrollable content area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Progress section: inside scroll, visible in both modes -->
            <LinearLayout
                android:id="@+id/MealProgressSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_surface_card"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md"
                android:layout_marginBottom="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/meal_progress_title"
                        android:textAppearance="@style/TextAppearance.AutoSecretary.SectionTitle" />

                    <TextView
                        android:id="@+id/MealProgressPeriod"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.AutoSecretary.Meal.RowSubtitle" />
                </LinearLayout>

                <TextView
                    android:id="@+id/MealCaloriesSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:textAppearance="@style/TextAppearance.AutoSecretary.Meal.RowTitle" />

                <ProgressBar
                    android:id="@+id/MealCaloriesProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:max="100"
                    android:minHeight="8dp"
                    android:progress="0" />

                <LinearLayout
                    android:id="@+id/MealFoodGroupProgressList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- ========== Dashboard (Übersicht) ========== -->
            <LinearLayout
                android:id="@+id/MealDashboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Section: Week Plan -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/meal_week_title"
                    android:textAppearance="@style/TextAppearance.AutoSecretary.SectionTitle" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/MealAddPlan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/meal_add_plan" />

                <include
                    layout="@layout/include_empty_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm" />

                <LinearLayout
                    android:id="@+id/MealWeekList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:orientation="vertical" />

                <!-- Section: Shopping List -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/meal_shopping_title"
                    android:textAppearance="@style/TextAppearance.AutoSecretary.SectionTitle" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/MealAddNeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/meal_add_need" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/meal_shopping_open_title"
                    android:textAppearance="@style/TextAppearance.AutoSecretary.Meal.RowBody" />

                <LinearLayout
                    android:id="@+id/MealShoppingOpenList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:orientation="vertical" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/MealHideDone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/meal_hide_done" />

                <TextView
                    android:id="@+id/MealShoppingDoneTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/meal_shopping_done_title"
                    android:textAppearance="@style/TextAppearance.AutoSecretary.Meal.RowBody" />

                <LinearLayout
                    android:id="@+id/MealShoppingDoneList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- ========== Management Screen (Verwalten) ========== -->
            <LinearLayout
                android:id="@+id/MealManageScreen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <include
                    layout="@layout/include_empty_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm" />

                <LinearLayout
                    android:id="@+id/MealManageList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:orientation="vertical" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom add button (visible in Verwalten mode only).
         Default text matches the initial RECIPES filter; updateManageAddButton() overrides at runtime. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/MealManageAddButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_md"
        android:text="@string/meal_manage_add_recipe"
        android:visibility="gone" />

</LinearLayout>
