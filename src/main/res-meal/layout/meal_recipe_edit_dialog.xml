<?xml version="1.0" encoding="utf-8"?>
<!-- Create / edit recipe dialog. Managed by MealRecipeDialogController.
     Spinners populated programmatically from enums. Ingredient rows added dynamically. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_lg">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.AutoSecretary.Editor.TextFieldLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/meal_recipe_label_title">

            <com.google.android.material.textfield.TextInputEditText
                style="@style/Widget.AutoSecretary.Editor.TextField"
                android:id="@+id/MealRecipeTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.AutoSecretary.Editor.TextFieldLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:hint="@string/meal_recipe_label_description">

            <com.google.android.material.textfield.TextInputEditText
                style="@style/Widget.AutoSecretary.Editor.TextField"
                android:id="@+id/MealRecipeDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:minLines="2" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.AutoSecretary.Editor.TextFieldLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:hint="@string/meal_recipe_label_instructions">

            <com.google.android.material.textfield.TextInputEditText
                style="@style/Widget.AutoSecretary.Editor.TextField"
                android:id="@+id/MealRecipeInstructions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:minLines="3" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Meal type spinner -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/meal_recipe_label_meal_types"
            android:textAppearance="@style/TextAppearance.AutoSecretary.Editor.Label"
            android:labelFor="@id/MealRecipeMealType" />

        <Spinner
            android:id="@+id/MealRecipeMealType"
            style="@style/Widget.AutoSecretary.Editor.Spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs" />

        <!-- Servings + times in horizontal groups -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.AutoSecretary.Editor.TextFieldLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/meal_recipe_label_servings">

                <com.google.android.material.textfield.TextInputEditText
                    style="@style/Widget.AutoSecretary.Editor.TextField"
                    android:id="@+id/MealRecipeServings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.AutoSecretary.Editor.TextFieldLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_sm"
                android:hint="@string/meal_recipe_label_prep_time">

                <com.google.android.material.textfield.TextInputEditText
                    style="@style/Widget.AutoSecretary.Editor.TextField"
                    android:id="@+id/MealRecipePrepTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.AutoSecretary.Editor.TextFieldLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_sm"
                android:hint="@string/meal_recipe_label_cook_time">

                <com.google.android.material.textfield.TextInputEditText
                    style="@style/Widget.AutoSecretary.Editor.TextField"
                    android:id="@+id/MealRecipeCookTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Effort spinner -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/meal_recipe_label_effort"
            android:textAppearance="@style/TextAppearance.AutoSecretary.Editor.Label"
            android:labelFor="@id/MealRecipeEffort" />

        <Spinner
            android:id="@+id/MealRecipeEffort"
            style="@style/Widget.AutoSecretary.Editor.Spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs" />

        <!-- Tags -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.AutoSecretary.Editor.TextFieldLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:hint="@string/meal_recipe_label_tags">

            <com.google.android.material.textfield.TextInputEditText
                style="@style/Widget.AutoSecretary.Editor.TextField"
                android:id="@+id/MealRecipeTags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Favorite checkbox -->
        <CheckBox
            android:id="@+id/MealRecipeFavorite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/meal_recipe_label_favorite" />

        <!-- Nutrition section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/meal_recipe_label_nutrition_header"
            android:textAppearance="@style/TextAppearance.AutoSecretary.Editor.Label" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.AutoSecretary.Editor.TextFieldLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/meal_recipe_label_calories">

                <com.google.android.material.textfield.TextInputEditText
                    style="@style/Widget.AutoSecretary.Editor.TextField"
                    android:id="@+id/MealRecipeCalories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.AutoSecretary.Editor.TextFieldLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_sm"
                android:hint="@string/meal_recipe_label_protein">

                <com.google.android.material.textfield.TextInputEditText
                    style="@style/Widget.AutoSecretary.Editor.TextField"
                    android:id="@+id/MealRecipeProtein"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.AutoSecretary.Editor.TextFieldLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/meal_recipe_label_carbs">

                <com.google.android.material.textfield.TextInputEditText
                    style="@style/Widget.AutoSecretary.Editor.TextField"
                    android:id="@+id/MealRecipeCarbs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.AutoSecretary.Editor.TextFieldLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_sm"
                android:hint="@string/meal_recipe_label_fat">

                <com.google.android.material.textfield.TextInputEditText
                    style="@style/Widget.AutoSecretary.Editor.TextField"
                    android:id="@+id/MealRecipeFat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Ingredients section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/meal_recipe_label_ingredients_header"
            android:textAppearance="@style/TextAppearance.AutoSecretary.Editor.Label" />

        <LinearLayout
            android:id="@+id/MealRecipeIngredientContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/MealRecipeAddIngredient"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:text="@string/meal_recipe_add_ingredient" />

    </LinearLayout>
</ScrollView>
