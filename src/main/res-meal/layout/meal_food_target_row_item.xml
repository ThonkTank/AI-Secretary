<?xml version="1.0" encoding="utf-8"?>
<!-- Row for weekly food target. Shows food group icon + label + target vs planned. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/spacing_lg"
    android:paddingVertical="@dimen/spacing_xs">

    <TextView
        android:id="@+id/MealFoodTargetIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/MealFoodTargetLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/spacing_sm"
        android:textAppearance="@style/TextAppearance.AutoSecretary.Meal.RowTitle" />

    <TextView
        android:id="@+id/MealFoodTargetValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.AutoSecretary.Meal.RowSubtitle" />
</LinearLayout>
