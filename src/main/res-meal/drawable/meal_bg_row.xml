<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded row background for meal list items (planned meals, recipes, pantry, shopping).
     Matches the task row visual treatment (task_bg_row.xml) for cross-feature consistency:
     semi-transparent surface, rounded corners, and a subtle outline. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@color/task_color_surface_semi_transparent" />
    <corners android:radius="@dimen/corner_radius_md" />
    <stroke android:width="1dp" android:color="@color/task_color_outline_semi" />
</shape>
