<?xml version="1.0" encoding="utf-8"?>
<!-- Budget overview screen. Managed by BudgetFragment + BudgetOverviewLoader.
     Sections from top to bottom:
       1. Account selector (Spinner) + chart range (MaterialButtonToggleGroup)
       2. Balance chart card (custom BudgetBalanceChartView)
       3. Month navigation (shared include_temporal_nav_bar)
       4. Monthly summary card (income/expense/free budget/net — shown/hidden by BudgetOverviewLoader)
       5. Limit bars (items inflated programmatically by BudgetOverviewLoader)
       6. Action buttons: add transaction, transfer, import statement
       7. Status/loading/empty state + retry
       8. Transaction rows (RecyclerView via BudgetTransactionAdapter)
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_lg">

        <!-- Account selector and chart range -->
        <Spinner
            android:id="@+id/BudgetAccountSpinner"
            style="@style/Widget.AutoSecretary.Editor.Spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:contentDescription="@string/budget_account_selector" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/BudgetRangeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            app:singleSelection="true"
            app:checkedButton="@id/BudgetRange30d">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/BudgetRange30d"
                style="@style/Widget.AutoSecretary.ToggleButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="@string/budget_range_30d_desc"
                android:text="@string/budget_range_30d" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/BudgetRange3m"
                style="@style/Widget.AutoSecretary.ToggleButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="@string/budget_range_3m_desc"
                android:text="@string/budget_range_3m" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/BudgetRange12m"
                style="@style/Widget.AutoSecretary.ToggleButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="@string/budget_range_12m_desc"
                android:text="@string/budget_range_12m" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Balance chart card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/BudgetChartCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            app:cardElevation="@dimen/budget_card_elevation"
            app:cardCornerRadius="@dimen/corner_radius_sm">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/budget_chart_title"
                    android:textAppearance="@style/TextAppearance.AutoSecretary.SectionTitle" />

                <com.autosecretary.features.budget.ui.internal.BudgetBalanceChartView
                    android:id="@+id/BudgetBalanceChart"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/budget_chart_height"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:contentDescription="@string/budget_chart_title" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Month navigation -->
        <include
            layout="@layout/include_temporal_nav_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm" />

        <!-- Monthly summary card (shown/hidden by BudgetOverviewLoader) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/BudgetSummaryCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:visibility="gone"
            app:cardCornerRadius="@dimen/corner_radius_sm"
            app:cardElevation="@dimen/budget_card_elevation">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/budget_summary_income"
                        android:textAppearance="@style/TextAppearance.AutoSecretary.Budget.RowLabel" />

                    <TextView
                        android:id="@+id/BudgetSummaryIncome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.AutoSecretary.Budget.RowValue" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/budget_summary_expense"
                        android:textAppearance="@style/TextAppearance.AutoSecretary.Budget.RowLabel" />

                    <TextView
                        android:id="@+id/BudgetSummaryExpense"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.AutoSecretary.Budget.RowValue" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/budget_summary_free_budget"
                        android:textAppearance="@style/TextAppearance.AutoSecretary.Budget.RowLabel" />
                    <TextView
                        android:id="@+id/BudgetSummaryFreeBudget"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.AutoSecretary.Budget.RowValue" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/budget_divider_height"
                    android:layout_marginVertical="@dimen/spacing_sm"
                    android:background="@color/budget_divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/budget_summary_net"
                        android:textAppearance="@style/TextAppearance.AutoSecretary.Budget.SummaryTotal" />

                    <TextView
                        android:id="@+id/BudgetSummaryNet"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.AutoSecretary.Budget.SummaryTotal" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Limit bars: items inflated programmatically by BudgetOverviewLoader -->
        <LinearLayout
            android:id="@+id/BudgetLimitBarsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:orientation="vertical"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/BudgetSetLimitButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/budget_set_limit_button"
            android:visibility="gone" />

        <!-- Action buttons -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/BudgetAddTransactionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="@string/budget_add_transaction" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/BudgetAddTransferButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/budget_add_transfer" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/BudgetImportStatementButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/budget_import_statement" />

        <!-- Loading / error / empty states (toggled by BudgetOverviewLoader) -->
        <TextView
            android:id="@+id/BudgetStatusMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="@string/budget_empty_state"
            android:textAppearance="@style/TextAppearance.AutoSecretary.Budget.RowLabel" />

        <ProgressBar
            android:id="@+id/BudgetLoading"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:contentDescription="@string/budget_loading"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/BudgetRetryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/budget_retry"
            android:visibility="gone" />

        <!-- Transaction rows: managed by BudgetTransactionAdapter via RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/BudgetTransactionList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>
</ScrollView>
