<?xml version="1.0" encoding="utf-8"?>
<!-- App widget layout: rendered via RemoteViews. Only platform views (TextView, ImageView,
     LinearLayout, Button, etc.) are supported — no RecyclerView, no custom views.
     See: https://developer.android.com/develop/ui/views/appwidgets#remoteviews -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_forest_gradient"
    android:padding="@dimen/spacing_sm">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/budget_widget_title"
        android:textAppearance="@style/TextAppearance.Budget.Widget.Header" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="@dimen/spacing_sm"
        android:padding="@dimen/spacing_sm"
        android:background="@drawable/bg_surface_card">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/budget_widget_total_label"
            android:textAppearance="@style/TextAppearance.Budget.Widget.CardLabel" />

        <TextView
            android:id="@+id/BudgetWidgetTotalValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Budget.Widget.CardValue" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/budget_widget_free_label"
            android:textAppearance="@style/TextAppearance.Budget.Widget.CardLabel" />

        <TextView
            android:id="@+id/BudgetWidgetFreeValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Budget.Widget.CardValueSecondary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/spacing_sm">

        <Button
            android:id="@+id/BudgetWidgetOpenButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/budget_widget_open" />

        <Button
            android:id="@+id/BudgetWidgetAddButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_xs"
            android:text="@string/budget_widget_add" />
    </LinearLayout>

</LinearLayout>
