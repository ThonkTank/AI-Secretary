<?xml version="1.0" encoding="utf-8"?>
<!-- Day picker button stroke color states: disabled → checked → default.

     Used by Widget.AutoSecretary.TaskEdit.DayPickerButton.

     Color scheme defined in task_colors.xml. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/task_color_primary_disabled_25" />
    <item android:state_checked="true" android:color="@color/task_color_primary" />
    <item android:color="@color/task_color_outline" />
</selector>
