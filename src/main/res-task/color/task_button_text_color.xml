<?xml version="1.0" encoding="utf-8"?>
<!-- Button text color states: disabled → checked → default.

     Used by:
     - Widget.AutoSecretary.TaskEdit.DayPickerButton (day selection buttons)

     Color scheme references shared palette in colors.xml. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/color_primary_disabled_50" />
    <item android:state_checked="true" android:color="@color/color_on_primary" />
    <item android:color="@color/color_primary" />
</selector>
