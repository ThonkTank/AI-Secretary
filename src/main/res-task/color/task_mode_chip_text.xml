<?xml version="1.0" encoding="utf-8"?>
<!-- Text color of the task list mode chips: cream on the filled selected chip, on-surface otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:color="@color/color_on_primary" />
    <item android:color="@color/color_on_surface" />
</selector>
