<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="@dimen/spacing_lg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ─── Titel + Priorität (immer sichtbar) ───────────────────────── -->

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.AutoSecretary.Editor.TextFieldLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/task_editor_hint_title">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/EditTitle"
                style="@style/Widget.AutoSecretary.Editor.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/Widget.AutoSecretary.Editor.SpinnerLabel"
            android:layout_marginTop="@dimen/spacing_sm"
            android:labelFor="@id/EditPriority"
            android:text="@string/task_editor_priority_label"/>

        <Spinner
            android:id="@+id/EditPriority"
            style="@style/Widget.AutoSecretary.Editor.SpinnerField"/>

        <TextView
            style="@style/Widget.AutoSecretary.Editor.SpinnerLabel"
            android:layout_marginTop="@dimen/spacing_sm"
            android:labelFor="@id/EditCategory"
            android:text="@string/task_editor_category_label"/>

        <Spinner
            android:id="@+id/EditCategory"
            style="@style/Widget.AutoSecretary.Editor.SpinnerField"/>

        <!-- ─── WEITERE OPTIONEN ─────────────────────────────────────────── -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/spacing_md"
            android:background="@color/color_outline"/>

        <LinearLayout
            android:id="@+id/WeitereDetailsHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:paddingTop="@dimen/spacing_sm"
            android:paddingBottom="@dimen/spacing_sm"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/WeitereDetailsToggle"
                style="@style/TextAppearance.AutoSecretary.Editor.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/task_editor_weitere_optionen_collapsed"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/WeitereDetailsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/spacing_sm"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.AutoSecretary.Editor.TextFieldLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:hint="@string/task_editor_hint_description">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/EditDescription"
                    style="@style/Widget.AutoSecretary.Editor.TextField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minLines="2"/>
            </com.google.android.material.textfield.TextInputLayout>

            <CheckBox
                android:id="@+id/EditLeisure"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/task_editor_leisure"/>

            <TextView
                style="@style/Widget.AutoSecretary.Editor.SpinnerLabel"
                android:layout_marginTop="@dimen/spacing_sm"
                android:labelFor="@id/EditSchedulingType"
                android:text="@string/task_editor_scheduling_type_label"/>

            <Spinner
                android:id="@+id/EditSchedulingType"
                style="@style/Widget.AutoSecretary.Editor.SpinnerField"/>

            <!-- Start date (TASK only) -->
            <LinearLayout
                android:id="@+id/TaskStartDateRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="@dimen/spacing_sm">

                <TextView
                    style="@style/TextAppearance.AutoSecretary.Editor.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/task_editor_start_date_label"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/StartDateInputLayout"
                    style="@style/Widget.AutoSecretary.Editor.TextFieldLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_sm"
                    app:endIconMode="custom"
                    app:endIconDrawable="@drawable/ic_calendar_24"
                    app:endIconContentDescription="@string/task_editor_start_date_pick_content_description">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/EditStartDate"
                        style="@style/Widget.AutoSecretary.Editor.TextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:inputType="none"
                        android:text="@string/task_editor_start_date_none"
                        android:contentDescription="@string/task_editor_start_date_pick_content_description"/>
                </com.google.android.material.textfield.TextInputLayout>

                <ImageButton
                    android:id="@+id/ClearStartDate"
                    android:layout_width="@dimen/touch_target_min"
                    android:layout_height="@dimen/touch_target_min"
                    android:src="@drawable/ic_close_24"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/task_editor_start_date_clear_content_description"/>
            </LinearLayout>

            <!-- Termin fields (TERMIN only) -->
            <LinearLayout
                android:id="@+id/TerminFieldsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="@dimen/spacing_sm">

                    <TextView
                        style="@style/TextAppearance.AutoSecretary.Editor.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/task_editor_fixed_date_label"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/FixedDateInputLayout"
                        style="@style/Widget.AutoSecretary.Editor.TextFieldLayout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_sm"
                        app:endIconMode="custom"
                        app:endIconDrawable="@drawable/ic_calendar_24"
                        app:endIconContentDescription="@string/task_editor_fixed_date_pick_content_description">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/EditFixedDate"
                            style="@style/Widget.AutoSecretary.Editor.TextField"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:inputType="none"
                            android:text="@string/task_editor_fixed_date_none"
                            android:contentDescription="@string/task_editor_fixed_date_pick_content_description"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <ImageButton
                        android:id="@+id/ClearFixedDate"
                        android:layout_width="@dimen/touch_target_min"
                        android:layout_height="@dimen/touch_target_min"
                        android:src="@drawable/ic_close_24"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/task_editor_fixed_date_clear_content_description"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="@dimen/spacing_sm">

                    <TextView
                        style="@style/TextAppearance.AutoSecretary.Editor.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/task_editor_fixed_start_label"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/FixedStartInputLayout"
                        style="@style/Widget.AutoSecretary.Editor.TextFieldLayout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_sm"
                        app:endIconMode="custom"
                        app:endIconDrawable="@drawable/ic_calendar_24"
                        app:endIconContentDescription="@string/task_editor_fixed_start_pick_content_description">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/EditFixedStart"
                            style="@style/Widget.AutoSecretary.Editor.TextField"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:inputType="none"
                            android:text="@string/task_editor_fixed_start_none"
                            android:contentDescription="@string/task_editor_fixed_start_pick_content_description"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <ImageButton
                        android:id="@+id/ClearFixedStart"
                        android:layout_width="@dimen/touch_target_min"
                        android:layout_height="@dimen/touch_target_min"
                        android:src="@drawable/ic_close_24"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/task_editor_fixed_start_clear_content_description"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="@dimen/spacing_sm">

                    <TextView
                        style="@style/TextAppearance.AutoSecretary.Editor.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/task_editor_fixed_duration_label"/>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.AutoSecretary.Editor.TextFieldLayout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:hint="@string/task_editor_hint_fixed_duration">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/EditFixedDuration"
                            style="@style/Widget.AutoSecretary.Editor.TextField"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Deadline -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="@dimen/spacing_sm">

                <TextView
                    style="@style/TextAppearance.AutoSecretary.Editor.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/task_editor_deadline_label"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/DeadlineInputLayout"
                    style="@style/Widget.AutoSecretary.Editor.TextFieldLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_sm"
                    app:endIconMode="custom"
                    app:endIconDrawable="@drawable/ic_calendar_24"
                    app:endIconContentDescription="@string/task_editor_deadline_pick_content_description">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/EditDeadline"
                        style="@style/Widget.AutoSecretary.Editor.TextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:inputType="none"
                        android:text="@string/task_editor_deadline_none"
                        android:contentDescription="@string/task_editor_deadline_pick_content_description"/>
                </com.google.android.material.textfield.TextInputLayout>

                <ImageButton
                    android:id="@+id/ClearDeadline"
                    android:layout_width="@dimen/touch_target_min"
                    android:layout_height="@dimen/touch_target_min"
                    android:src="@drawable/ic_close_24"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/task_editor_deadline_clear_content_description"/>
            </LinearLayout>

            <!-- Dauer -->
            <TextView
                style="@style/TextAppearance.AutoSecretary.Editor.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/task_editor_duration_label"/>

            <LinearLayout
                style="@style/Widget.AutoSecretary.Editor.RangeRow"
                android:layout_marginTop="@dimen/spacing_xs">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.AutoSecretary.Editor.TextFieldLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/task_editor_hint_min">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/EditMinDuration"
                        style="@style/Widget.AutoSecretary.Editor.TextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"/>
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/Widget.AutoSecretary.Editor.RangeSeparator"
                    android:text="@string/task_editor_range_separator"/>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.AutoSecretary.Editor.TextFieldLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/task_editor_hint_max">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/EditMaxDuration"
                        style="@style/Widget.AutoSecretary.Editor.TextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"/>
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Cooldown -->
            <LinearLayout
                style="@style/Widget.AutoSecretary.Editor.RangeRow"
                android:layout_marginTop="@dimen/spacing_sm">

                <TextView
                    style="@style/TextAppearance.AutoSecretary.Editor.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/task_editor_cooldown_label"/>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.AutoSecretary.Editor.TextFieldLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_sm">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/EditCooldown"
                        style="@style/Widget.AutoSecretary.Editor.TextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"/>
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <CheckBox
                android:id="@+id/EditCloseOnMiss"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/task_editor_close_on_miss"/>

        </LinearLayout>

        <!-- ─── WIEDERHOLUNG ─────────────────────────────────────────────── -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/color_outline"/>

        <LinearLayout
            android:id="@+id/WiederholungHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:paddingTop="@dimen/spacing_sm"
            android:paddingBottom="@dimen/spacing_sm"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/WiederholungToggle"
                style="@style/TextAppearance.AutoSecretary.Editor.Label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/task_editor_section_wiederholung"/>

            <TextView
                android:id="@+id/RepetitionSummary"
                style="@style/TextAppearance.AutoSecretary.Editor.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:textStyle="normal"
                android:textColor="@color/color_on_surface_variant"
                android:visibility="gone"/>

            <!-- ToggleRepetition: on/off for the section. Its isChecked() is read by
                 TaskEditFormInputReader to decide whether to save repetition data. -->
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/ToggleRepetition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"/>
        </LinearLayout>

        <!-- RepetitionContainer: section body, shown when ToggleRepetition is on. -->
        <LinearLayout
            android:id="@+id/RepetitionContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/spacing_sm"
            android:visibility="gone">

            <!-- Inline: [EditReps] mal pro [EditPerPeriod] [EditPeriodUnit] -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="@dimen/spacing_xs">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.AutoSecretary.Editor.TextFieldLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5"
                    android:hint="@string/task_editor_hint_reps">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/EditReps"
                        style="@style/Widget.AutoSecretary.Editor.TextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:gravity="center"/>
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/TextAppearance.AutoSecretary.Editor.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/task_editor_repetition_format"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:layout_marginEnd="@dimen/spacing_sm"/>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.AutoSecretary.Editor.TextFieldLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5"
                    android:hint="@string/task_editor_hint_per_period">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/EditPerPeriod"
                        style="@style/Widget.AutoSecretary.Editor.TextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:gravity="center"/>
                </com.google.android.material.textfield.TextInputLayout>

                <Spinner
                    android:id="@+id/EditPeriodUnit"
                    style="@style/Widget.AutoSecretary.Editor.Spinner"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:contentDescription="@string/task_editor_period_unit_content_description"/>
            </LinearLayout>

            <CheckBox
                android:id="@+id/EditCompleteFirst"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/task_editor_complete_first"/>

            <!-- Zeitfenster -->

            <TextView
                style="@style/TextAppearance.AutoSecretary.Editor.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/task_editor_pref_slots_section_label"/>

            <LinearLayout
                android:id="@+id/PrefSlotContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/spacing_sm"/>

            <CheckBox
                android:id="@+id/EditAdaptive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/task_editor_adaptive_times"/>

        </LinearLayout>

        <!-- ─── FORTSCHRITT ──────────────────────────────────────────────── -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/color_outline"/>

        <LinearLayout
            android:id="@+id/FortschrittHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:paddingTop="@dimen/spacing_sm"
            android:paddingBottom="@dimen/spacing_sm"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/FortschrittToggle"
                style="@style/TextAppearance.AutoSecretary.Editor.Label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/task_editor_section_fortschritt"/>

            <!-- ToggleProgress: on/off for the section. Its isChecked() is read by
                 TaskEditFormInputReader to decide whether to save progress data. -->
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/ToggleProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"/>
        </LinearLayout>

        <!-- ProgressContainer: section body, shown when ToggleProgress is on. -->
        <LinearLayout
            android:id="@+id/ProgressContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/spacing_sm"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="@dimen/spacing_xs">

                <TextView
                    style="@style/TextAppearance.AutoSecretary.Editor.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/task_editor_unit_label"/>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.AutoSecretary.Editor.TextFieldLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:hint="@string/task_editor_hint_unit_example">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/EditUnit"
                        style="@style/Widget.AutoSecretary.Editor.TextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="@dimen/spacing_sm">

                <TextView
                    style="@style/TextAppearance.AutoSecretary.Editor.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/task_editor_target_label"/>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.AutoSecretary.Editor.TextFieldLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_sm">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/EditTarget"
                        style="@style/Widget.AutoSecretary.Editor.TextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"/>
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="@dimen/spacing_sm">

                <TextView
                    style="@style/TextAppearance.AutoSecretary.Editor.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/task_editor_current_label"/>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.AutoSecretary.Editor.TextFieldLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_sm">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/EditCurrent"
                        style="@style/Widget.AutoSecretary.Editor.TextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"/>
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <CheckBox
                android:id="@+id/EditResetPerRep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/task_editor_reset_per_repetition"/>

            <TextView
                style="@style/TextAppearance.AutoSecretary.Editor.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/task_editor_per_repetition_label"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="@dimen/spacing_sm">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.AutoSecretary.Editor.TextFieldLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/task_editor_hint_min">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/EditMinPerRep"
                        style="@style/Widget.AutoSecretary.Editor.TextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"/>
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/Widget.AutoSecretary.Editor.RangeSeparator"
                    android:text="@string/task_editor_range_separator"/>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.AutoSecretary.Editor.TextFieldLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/task_editor_hint_max">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/EditMaxPerRep"
                        style="@style/Widget.AutoSecretary.Editor.TextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"/>
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ─── BUDGET ───────────────────────────────────────────────────── -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/color_outline"/>

        <LinearLayout
            android:id="@+id/BudgetHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:paddingTop="@dimen/spacing_sm"
            android:paddingBottom="@dimen/spacing_sm"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/BudgetToggle"
                style="@style/TextAppearance.AutoSecretary.Editor.Label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/task_editor_section_budget"/>

            <!-- ToggleBudget: on/off for the section. Its isChecked() is read by
                 TaskEditFormInputReader to decide whether to save budget data. -->
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/ToggleBudget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"/>
        </LinearLayout>

        <!-- BudgetContainer: section body, shown when ToggleBudget is on. -->
        <LinearLayout
            android:id="@+id/BudgetContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/spacing_sm"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.AutoSecretary.Editor.TextFieldLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:hint="@string/task_editor_budget_required_cents_label">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/EditBudgetRequiredCents"
                    style="@style/Widget.AutoSecretary.Editor.TextField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"/>
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/Widget.AutoSecretary.Editor.SpinnerLabel"
                android:layout_marginTop="@dimen/spacing_sm"
                android:labelFor="@id/EditBudgetAccountId"
                android:text="@string/task_editor_budget_account_content_description"/>

            <Spinner
                android:id="@+id/EditBudgetAccountId"
                style="@style/Widget.AutoSecretary.Editor.SpinnerField"/>

            <TextView
                style="@style/Widget.AutoSecretary.Editor.SpinnerLabel"
                android:layout_marginTop="@dimen/spacing_sm"
                android:labelFor="@id/EditBudgetCategoryId"
                android:text="@string/task_editor_budget_category_content_description"/>

            <Spinner
                android:id="@+id/EditBudgetCategoryId"
                style="@style/Widget.AutoSecretary.Editor.SpinnerField"/>

        </LinearLayout>

        <!-- Bottom padding so last section isn't flush against dialog edge -->
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/spacing_sm"/>

    </LinearLayout>
</ScrollView>
