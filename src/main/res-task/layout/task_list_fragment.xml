<?xml version="1.0" encoding="utf-8"?>
<!-- Task list screen. Managed by TaskListFragment + TaskViewModel.
     Sections from top to bottom:
       1. Header bar: headline ("Heute" / date in day-scoped modes, mode title in flat modes)
          + day chevrons (hidden in the flat modes Priorität/Frist)
       2. Mode chips: horizontally scrollable single-select row
          (Checkliste / Verwalten / Priorität / Frist)
       3. Search bar (visible only in Verwalten mode, toggled by TaskListFragment)
       4. Task list (RecyclerView via ListRowAdapter) OR empty-state container — only one visible,
          with the "Neue Aufgabe" FAB overlaid bottom-end
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/spacing_lg"
    android:paddingTop="@dimen/spacing_sm">

    <!-- Header: headline + day navigation chevrons -->
    <LinearLayout
        android:id="@+id/TaskHeaderBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/touch_target_min"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/TaskHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAppearance="@style/TextAppearance.AutoSecretary.Task.HeaderTitle"/>

        <ImageButton
            android:id="@+id/TaskDayPrev"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/task_list_day_nav_prev_desc"
            android:src="@drawable/ic_chevron_left_24"
            app:tint="?attr/colorPrimary"/>

        <ImageButton
            android:id="@+id/TaskDayNext"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/task_list_day_nav_next_desc"
            android:src="@drawable/ic_chevron_right_24"
            app:tint="?attr/colorPrimary"/>
    </LinearLayout>

    <!-- Mode chips: scrollable single-select row -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/TaskModeChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:chipSpacingHorizontal="@dimen/spacing_sm">

            <com.google.android.material.chip.Chip
                android:id="@+id/TaskModeChecklistChip"
                style="@style/Widget.AutoSecretary.Task.ModeChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/task_list_mode_checklist"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/TaskModeManageChip"
                style="@style/Widget.AutoSecretary.Task.ModeChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/task_list_mode_manage"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/TaskModeUrgencyChip"
                style="@style/Widget.AutoSecretary.Task.ModeChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/task_list_mode_urgency"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/TaskModeDeadlineChip"
                style="@style/Widget.AutoSecretary.Task.ModeChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/task_list_mode_deadline"/>
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Search bar: visible only in Verwalten mode, toggled by TaskListFragment -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/TaskSearchLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:visibility="gone"
        android:hint="@string/task_list_search_hint"
        app:endIconMode="clear_text"
        style="@style/Widget.AutoSecretary.Editor.TextFieldLayout">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/TaskSearchInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            style="@style/Widget.AutoSecretary.Editor.TextField" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Task list + empty state (only one visible), with the create FAB overlaid bottom-end -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/spacing_sm">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/TaskList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/task_list_fab_clearance"/>

        <LinearLayout
            android:id="@+id/TaskEmptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <include
                layout="@layout/include_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="visible" />
        </LinearLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/NewTaskFab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="@dimen/spacing_lg"
            android:contentDescription="@string/task_list_new_task"
            android:src="@drawable/ic_add_24"
            app:backgroundTint="@color/color_primary"
            app:tint="@color/color_on_primary" />

    </FrameLayout>

</LinearLayout>
