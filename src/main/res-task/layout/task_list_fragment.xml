<?xml version="1.0" encoding="utf-8"?>
<!-- Task list screen. Managed by TaskListFragment + TaskViewModel.
     Sections from top to bottom:
       1. Day navigation bar (prev/today/next)
       2. Controls card: checklist/manage toggle, search bar
          (search bar visible only in Manage mode, toggled by TaskListFragment)
       3. Task list (RecyclerView via ListRowAdapter) OR empty-state container — only one visible
       4. "Neue Task" button (always visible at bottom)
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:paddingHorizontal="@dimen/spacing_sm"
    android:paddingTop="@dimen/spacing_sm">

    <include
        layout="@layout/include_temporal_nav_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_sm"
        android:layout_marginBottom="@dimen/spacing_xs" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:layout_marginHorizontal="@dimen/spacing_sm"
        android:orientation="vertical"
        android:background="@drawable/bg_surface_card"
        android:paddingHorizontal="@dimen/spacing_md"
        android:paddingVertical="@dimen/spacing_sm">

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/TaskListToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:checkedButton="@+id/ChecklistButton">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ChecklistButton"
                style="@style/Widget.AutoSecretary.ToggleButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/task_list_toggle_checklist" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ManagementButton"
                style="@style/Widget.AutoSecretary.ToggleButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/task_list_toggle_manage" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Search bar: visible only in Manage mode, toggled by TaskListFragment -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/TaskSearchLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:visibility="gone"
            android:hint="@string/task_list_search_hint"
            app:endIconMode="clear_text"
            style="@style/Widget.AutoSecretary.Editor.TextFieldLayout">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/TaskSearchInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                style="@style/Widget.AutoSecretary.Editor.TextField" />
        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

    <!-- Task list and empty state: only one visible at a time, toggled by TaskListFragment -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/TaskList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/spacing_sm"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/spacing_sm"/>

    <LinearLayout
        android:id="@+id/EmptyStateContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/spacing_lg"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/task_list_empty_title"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6"
            android:textAlignment="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/task_list_empty_subtitle"
            android:textAlignment="center" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/EmptyStateNewTaskButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/task_list_empty_action"
            android:textAppearance="@style/TextAppearance.Task.Widget.NewTaskCta" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/NewTaskButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_md"
        style="?attr/materialButtonStyle"
        android:text="@string/task_list_new_task"
        android:textAppearance="@style/TextAppearance.Task.Widget.NewTaskCta"/>

</LinearLayout>
