<?xml version="1.0" encoding="utf-8"?>
<!-- Category-window dialog content. CategoryWindowLoading shows while data loads;
     CategoryWindowContainer is revealed on success with one section per weekday (a header,
     the day's block rows, and an "add block" button) inflated programmatically by
     TaskCategoryWindowDialog. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/spacing_lg">

    <ProgressBar
        android:id="@+id/CategoryWindowLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/CategoryWindowContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />
    </ScrollView>

</FrameLayout>
