<?xml version="1.0" encoding="utf-8"?>
<!-- Category-management dialog content. CategoryManageLoading shows while data loads;
     CategoryManageContainer is revealed on success with one row per category inflated
     programmatically by TaskCategoryDialog. The add button appends a new empty row. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/spacing_lg">

    <ProgressBar
        android:id="@+id/CategoryManageLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/CategoryManageContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Category rows inflated programmatically by TaskCategoryDialog -->
            <LinearLayout
                android:id="@+id/CategoryManageContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/CategoryManageAddButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/task_category_add"
                android:textAllCaps="false" />
        </LinearLayout>
    </ScrollView>

</FrameLayout>
