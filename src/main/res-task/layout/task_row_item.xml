<?xml version="1.0" encoding="utf-8"?>
<!-- Task/calendar row: agenda layout. Inflated by ListRowAdapter (VIEW_TYPE_ROW) into the
     TaskList RecyclerView; category headers use task_row_header_item.xml instead.

     Anatomy (left to right):
       1. TimeRail — start time stacked over end time; Checklist mode only.
       2. StateLine — thin vertical line tinted by task state (open/in progress/completed/calendar);
          Checklist mode only.
       3. TaskCard — the interactive card (click, long-press, state background, completion flash):
          line 1: control (checkbox OR state button OR expand toggle) + title (max 2 lines)
                  + compact progress stepper for goal tasks;
          line 2: metadata (goal icon, time range in non-checklist modes, deadline bar in Frist
                  mode, deadline label, streak, calendar chip) — hidden when empty.

     Visibility is driven per display mode and item state by ListRowAdapter; everything except
     the title starts out gone or is reset on each bind. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/TaskRowRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_xs"
    android:orientation="horizontal">

    <!-- Time rail: agenda-style stacked start/end times (Checklist mode only) -->
    <LinearLayout
        android:id="@+id/TimeRail"
        android:layout_width="@dimen/task_row_rail_width"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:paddingEnd="@dimen/spacing_xs"
        android:importantForAccessibility="no"
        android:visibility="gone">

        <TextView
            android:id="@+id/TimeStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textAppearance="@style/TextAppearance.AutoSecretary.Task.Time.Primary"/>

        <TextView
            android:id="@+id/TimeEnd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textAppearance="@style/TextAppearance.AutoSecretary.Task.Time.Secondary"/>
    </LinearLayout>

    <!-- State line: tinted at runtime (open/in progress/completed/calendar) -->
    <View
        android:id="@+id/StateLine"
        android:layout_width="@dimen/task_row_state_line_width"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/spacing_xxs"
        android:layout_marginBottom="@dimen/spacing_xxs"
        android:layout_marginEnd="@dimen/spacing_sm"
        android:background="@drawable/task_bg_state_line"
        android:importantForAccessibility="no"
        android:visibility="gone"/>

    <!-- The interactive card: single a11y/click/animation target for the row -->
    <LinearLayout
        android:id="@+id/TaskCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:minHeight="@dimen/row_min_height"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:background="@drawable/bg_row"
        android:foreground="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:paddingStart="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_sm"
        android:paddingTop="@dimen/spacing_xs"
        android:paddingBottom="@dimen/spacing_xs">

        <!-- Line 1: control + full-width title + compact progress stepper -->
        <LinearLayout
            android:id="@+id/TitleLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <CheckBox
                android:id="@+id/TaskCheckBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/touch_target_min"
                android:minHeight="@dimen/touch_target_min"
                android:buttonTint="@color/color_primary"/>

            <ImageButton
                android:id="@+id/TaskStateButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/touch_target_min"
                android:minHeight="@dimen/touch_target_min"
                android:layout_marginEnd="@dimen/spacing_xs"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/task_row_state_button_in_progress"
                android:padding="@dimen/spacing_sm"
                android:src="@drawable/ic_play_24"
                android:visibility="gone"
                app:tint="@color/color_primary"/>

            <!-- Expand/collapse toggle: parent task rows with children (Manage mode) -->
            <TextView
                android:id="@+id/ExpandToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_xs"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:importantForAccessibility="yes"
                android:minWidth="@dimen/touch_target_min"
                android:minHeight="@dimen/touch_target_min"
                android:textAppearance="@style/TextAppearance.AutoSecretary.Task.Time.Primary"
                android:textColor="@color/color_on_surface_emphasis"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/TaskTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="2"
                android:ellipsize="end"
                android:textAppearance="@style/TextAppearance.AutoSecretary.Task.Title"/>

            <!-- Compact progress stepper for goal tasks: − 3/10 + -->
            <LinearLayout
                android:id="@+id/ProgressContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_xs"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/ProgressMinusButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/touch_target_min"
                    android:minHeight="@dimen/touch_target_min"
                    android:padding="@dimen/spacing_md"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/task_progress_decrement"
                    android:src="@drawable/ic_remove_24"
                    app:tint="@color/task_progress_button_tint"/>

                <TextView
                    android:id="@+id/ProgressText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.AutoSecretary.Task.Metadata"
                    android:textColor="@color/task_progress_text"/>

                <ImageButton
                    android:id="@+id/ProgressPlusButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/touch_target_min"
                    android:minHeight="@dimen/touch_target_min"
                    android:padding="@dimen/spacing_md"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/task_progress_increment"
                    android:src="@drawable/ic_add_24"
                    app:tint="@color/task_progress_button_tint"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Line 2: metadata; ListRowAdapter hides the whole line when no child is visible -->
        <LinearLayout
            android:id="@+id/MetadataLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xxs"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/GoalIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:textAppearance="@style/TextAppearance.AutoSecretary.Task.Metadata"
                android:visibility="gone"/>

            <!-- Time range in non-checklist modes (the rail carries it in Checklist mode) -->
            <TextView
                android:id="@+id/MetaTimeRange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:textAppearance="@style/TextAppearance.AutoSecretary.Task.Metadata"
                android:visibility="gone"/>

            <!-- Remaining-time bar: Frist mode only (elapsed share of created→deadline) -->
            <ProgressBar
                android:id="@+id/DeadlineProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="@dimen/task_row_deadline_bar_width"
                android:layout_height="@dimen/task_row_deadline_bar_height"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:max="100"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/DeadlineCountdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:textAppearance="@style/TextAppearance.AutoSecretary.Task.Metadata"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/StreakDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:textAppearance="@style/TextAppearance.AutoSecretary.Task.Metadata"
                android:visibility="gone"/>

            <!-- Calendar chip: device-calendar event rows -->
            <TextView
                android:id="@+id/CalendarChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/task_bg_calendar_chip"
                android:paddingStart="@dimen/spacing_sm"
                android:paddingEnd="@dimen/spacing_sm"
                android:paddingTop="@dimen/spacing_xxs"
                android:paddingBottom="@dimen/spacing_xxs"
                android:textAppearance="@style/TextAppearance.AutoSecretary.Task.Metadata"
                android:visibility="gone"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
