<?xml version="1.0" encoding="utf-8"?>
<!-- Task row item. Inflated by ListRowAdapter into the TaskList RecyclerView.
     Sections left-to-right: time range → checkbox → optional goal icon →
     optional progress controls → optional expand toggle → title (weight=1) →
     metadata row (deadline/streak/calendar chip).
     Optional sections are shown/hidden by ListRowAdapter based on ViewSlot state.
     Editing is reached via row long-press or the "Bearbeiten" action in the description popup. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/TaskRowRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/row_min_height"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginBottom="@dimen/spacing_xs"
    android:background="@drawable/bg_row"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:paddingStart="@dimen/spacing_lg"
    android:paddingEnd="@dimen/spacing_sm"
    android:paddingVertical="@dimen/spacing_xs">

    <TextView
        android:id="@+id/TimeRange"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/task_row_time_column_min_width"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.AutoSecretary.Task.Time.Primary"/>

    <CheckBox
        android:id="@+id/TaskCheckBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/touch_target_min"
        android:minHeight="@dimen/touch_target_min"
        android:buttonTint="@color/color_primary"/>

    <ImageButton
        android:id="@+id/TaskStateButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/touch_target_min"
        android:minHeight="@dimen/touch_target_min"
        android:layout_marginEnd="@dimen/spacing_xs"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/task_row_state_button_in_progress"
        android:padding="@dimen/spacing_sm"
        android:src="@drawable/ic_play_24"
        android:visibility="gone"
        app:tint="@color/color_primary"/>

    <!-- Goal icon: shown when task has a goal emoji set -->
    <TextView
        android:id="@+id/GoalIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/spacing_xs"
        android:textAppearance="@style/TextAppearance.AutoSecretary.Task.Title"
        android:visibility="gone"/>

    <!-- Progress controls: shown when task has progress tracking enabled -->
    <LinearLayout
        android:id="@+id/ProgressContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/spacing_xs"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/ProgressMinusButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/touch_target_min"
            android:minHeight="@dimen/touch_target_min"
            android:padding="@dimen/spacing_xs"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/task_progress_decrement"
            android:src="@drawable/ic_remove_24"
            app:tint="@color/task_progress_button_tint"/>

        <TextView
            android:id="@+id/ProgressText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_xxs"
            android:layout_marginEnd="@dimen/spacing_xxs"
            android:textAppearance="@style/TextAppearance.AutoSecretary.Task.Metadata"
            android:textColor="@color/task_progress_text"/>

        <ImageButton
            android:id="@+id/ProgressPlusButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/touch_target_min"
            android:minHeight="@dimen/touch_target_min"
            android:padding="@dimen/spacing_xs"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/task_progress_increment"
            android:src="@drawable/ic_add_24"
            app:tint="@color/task_progress_button_tint"/>
    </LinearLayout>

    <!-- Expand/collapse toggle: shown for parent tasks with children (Manage mode) -->
    <TextView
        android:id="@+id/ExpandToggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/spacing_xs"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:importantForAccessibility="yes"
        android:minWidth="@dimen/task_row_expand_toggle_min_width"
        android:minHeight="@dimen/touch_target_min"
        android:textAppearance="@style/TextAppearance.AutoSecretary.Task.Time.Primary"
        android:textColor="@color/color_on_surface_emphasis"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/TaskTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.AutoSecretary.Task.Title"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical|end"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_sm"
        android:paddingEnd="@dimen/spacing_xs">

        <!-- Remaining-time bar: shown only in Deadline mode (elapsed share of created→deadline) -->
        <ProgressBar
            android:id="@+id/DeadlineProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="@dimen/task_row_deadline_bar_width"
            android:layout_height="@dimen/task_row_deadline_bar_height"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:max="100"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/DeadlineCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.AutoSecretary.Task.Metadata"/>

        <TextView
            android:id="@+id/StreakDisplay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.AutoSecretary.Task.Metadata"/>

        <!-- Calendar chip: shown when slot overlaps a device calendar event -->
        <TextView
            android:id="@+id/CalendarChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:background="@drawable/task_bg_calendar_chip"
            android:paddingHorizontal="@dimen/spacing_sm"
            android:paddingVertical="@dimen/spacing_xxs"
            android:textAppearance="@style/TextAppearance.AutoSecretary.Task.Metadata"
            android:visibility="gone"/>
    </LinearLayout>
</LinearLayout>
