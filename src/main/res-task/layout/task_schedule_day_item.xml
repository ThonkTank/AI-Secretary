<?xml version="1.0" encoding="utf-8"?>
<!-- Single day row in the schedule-config dialog. Inflated programmatically by
     TaskScheduleConfigDialog into ScheduleConfigContainer. Start/end button text
     is set at runtime to show the configured time window for each weekday. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="@dimen/spacing_sm">

    <TextView
        android:id="@+id/ScheduleDayLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.MaterialComponents.Body1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/ScheduleStartButton"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="@dimen/task_schedule_day_time_button_width"
        android:layout_height="wrap_content"
        android:textAllCaps="false" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_sm"
        android:layout_marginEnd="@dimen/spacing_sm"
        android:text="@string/task_schedule_range_separator" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/ScheduleEndButton"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="@dimen/task_schedule_day_time_button_width"
        android:layout_height="wrap_content"
        android:textAllCaps="false" />

</LinearLayout>
