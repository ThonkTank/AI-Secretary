<?xml version="1.0" encoding="utf-8"?>
<!-- Model-picker spinner item (selected value + dropdown rows) for the assistant chat. Replaces the
     framework simple_spinner_item so the model chip uses the app's font and on-surface color. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/touch_target_min"
    android:gravity="center_vertical"
    android:paddingTop="@dimen/spacing_sm"
    android:paddingBottom="@dimen/spacing_sm"
    android:ellipsize="end"
    android:maxLines="1"
    android:textAppearance="@style/TextAppearance.AutoSecretary.RowPrimary" />
