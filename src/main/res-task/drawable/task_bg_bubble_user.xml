<?xml version="1.0" encoding="utf-8"?>
<!-- Assistant chat: the user's own message bubble. Low-alpha primary tint, aligned to the
     end (right) side; the bottom-right corner is tightened for a chat-tail feel. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@color/task_assistant_user_bubble" />
    <corners
        android:topLeftRadius="@dimen/task_chat_bubble_corner"
        android:topRightRadius="@dimen/task_chat_bubble_corner"
        android:bottomLeftRadius="@dimen/task_chat_bubble_corner"
        android:bottomRightRadius="@dimen/spacing_xs" />
</shape>
