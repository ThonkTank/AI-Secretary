<?xml version="1.0" encoding="utf-8"?>
<!-- Row background for task items when shown in calendar/checklist view.
     Applied programmatically in ListRowAdapter (not referenced from XML layouts). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@color/task_calendar_background"/>
    <corners android:radius="@dimen/task_corner_radius_sm"/>
    <stroke
        android:width="1dp"
        android:color="@color/task_calendar_outline"/>
</shape>
