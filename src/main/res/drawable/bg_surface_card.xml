<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded card surface with outline border. Used for elevated content panels:
     toolbar containers, editor panels, widget inner cards, and task list header. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@color/color_surface" />
    <corners android:radius="@dimen/corner_radius_lg" />
    <stroke android:width="@dimen/outline_stroke_width" android:color="@color/color_outline" />
</shape>
