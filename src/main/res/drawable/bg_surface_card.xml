<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded card surface with outline border. Used for elevated content panels:
     toolbar containers, editor panels, widget inner cards, and task list header. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/task_color_surface" />
    <corners android:radius="@dimen/task_corner_radius_xl" />
    <stroke android:width="1dp" android:color="@color/task_color_outline" />
</shape>
