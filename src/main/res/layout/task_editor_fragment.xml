<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="@dimen/spacing_sm">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_surface_card"
        android:padding="@dimen/spacing_lg">

        <!-- Basic Info -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.AISecretary.Editor.TextFieldLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/task_editor_hint_title">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/EditTitle"
                style="@style/Widget.AISecretary.Editor.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.AISecretary.Editor.TextFieldLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:hint="@string/task_editor_hint_description">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/EditDescription"
                style="@style/Widget.AISecretary.Editor.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="2"/>
        </com.google.android.material.textfield.TextInputLayout>

        <Spinner
            android:id="@+id/EditPriority"
            style="@style/Widget.AISecretary.Editor.Spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"/>

        <!-- Scheduling: Deadline -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/spacing_md">

            <TextView
                style="@style/TextAppearance.AISecretary.Editor.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/task_editor_deadline_label"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/DeadlineInputLayout"
                style="@style/Widget.AISecretary.Editor.TextFieldLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_sm"
                app:endIconMode="custom"
                app:endIconDrawable="@android:drawable/ic_menu_my_calendar"
                app:endIconContentDescription="@string/task_editor_deadline_pick_content_description">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/EditDeadline"
                    style="@style/Widget.AISecretary.Editor.TextField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:clickable="true"
                    android:longClickable="false"
                    android:inputType="none"
                    android:text="@string/task_editor_deadline_none"
                    android:contentDescription="@string/task_editor_deadline_pick_content_description"/>
            </com.google.android.material.textfield.TextInputLayout>

            <ImageButton
                android:id="@+id/ClearDeadline"
                android:layout_width="@dimen/task_editor_clear_deadline_button_size"
                android:layout_height="@dimen/task_editor_clear_deadline_button_size"
                android:minWidth="@dimen/task_editor_clear_deadline_button_size"
                android:minHeight="@dimen/task_editor_clear_deadline_button_size"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/task_editor_deadline_clear_content_description"/>
        </LinearLayout>

        <CheckBox
            android:id="@+id/EditCloseOnMiss"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/task_editor_close_on_miss"/>

        <!-- Duration -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/spacing_sm">

            <TextView
                style="@style/TextAppearance.AISecretary.Editor.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/task_editor_duration_label"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="@dimen/spacing_sm">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.AISecretary.Editor.TextFieldLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/task_editor_hint_min">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/EditMinDuration"
                        style="@style/Widget.AISecretary.Editor.TextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"/>
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/TextAppearance.AISecretary.Editor.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/task_editor_range_separator"
                    android:layout_marginStart="@dimen/spacing_xs"
                    android:layout_marginEnd="@dimen/spacing_xs"/>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.AISecretary.Editor.TextFieldLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/task_editor_hint_max">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/EditMaxDuration"
                        style="@style/Widget.AISecretary.Editor.TextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"/>
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Cooldown -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/spacing_sm">

            <TextView
                style="@style/TextAppearance.AISecretary.Editor.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/task_editor_cooldown_label"/>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.AISecretary.Editor.TextFieldLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_sm">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/EditCooldown"
                    style="@style/Widget.AISecretary.Editor.TextField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"/>
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Repetition -->
        <CheckBox
            android:id="@+id/ToggleRepetition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/task_editor_repetition_toggle"/>

        <LinearLayout
            android:id="@+id/RepetitionContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingStart="@dimen/editor_section_indent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.AISecretary.Editor.TextFieldLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/EditReps"
                        style="@style/Widget.AISecretary.Editor.TextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:gravity="center"/>
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/TextAppearance.AISecretary.Editor.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/task_editor_repetition_format"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:layout_marginEnd="@dimen/spacing_sm"/>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.AISecretary.Editor.TextFieldLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/EditPerPeriod"
                        style="@style/Widget.AISecretary.Editor.TextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:gravity="center"/>
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <Spinner
                android:id="@+id/EditPeriodUnit"
                style="@style/Widget.AISecretary.Editor.Spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"/>
        </LinearLayout>

        <!-- PrefSlots -->
        <LinearLayout
            android:id="@+id/PrefSlotContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/spacing_sm"/>

        <CheckBox
            android:id="@+id/EditAdaptive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/task_editor_adaptive_times"/>

        <!-- Progress -->
        <CheckBox
            android:id="@+id/ToggleProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/task_editor_progress_toggle"/>

        <LinearLayout
            android:id="@+id/ProgressContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingStart="@dimen/editor_section_indent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    style="@style/TextAppearance.AISecretary.Editor.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/task_editor_unit_label"/>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.AISecretary.Editor.TextFieldLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:hint="@string/task_editor_hint_unit_example">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/EditUnit"
                        style="@style/Widget.AISecretary.Editor.TextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        style="@style/TextAppearance.AISecretary.Editor.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/task_editor_target_label"/>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.AISecretary.Editor.TextFieldLayout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_sm">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/EditTarget"
                            style="@style/Widget.AISecretary.Editor.TextField"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="@dimen/spacing_sm">

                    <TextView
                        style="@style/TextAppearance.AISecretary.Editor.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/task_editor_current_label"/>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.AISecretary.Editor.TextFieldLayout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_sm">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/EditCurrent"
                            style="@style/Widget.AISecretary.Editor.TextField"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>

            <CheckBox
                android:id="@+id/EditResetPerRep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/task_editor_reset_per_repetition"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.AISecretary.Editor.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/task_editor_per_repetition_label"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="@dimen/spacing_sm">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.AISecretary.Editor.TextFieldLayout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/task_editor_hint_min">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/EditMinPerRep"
                            style="@style/Widget.AISecretary.Editor.TextField"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        style="@style/TextAppearance.AISecretary.Editor.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/task_editor_range_separator"
                        android:layout_marginStart="@dimen/spacing_xs"
                        android:layout_marginEnd="@dimen/spacing_xs"/>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.AISecretary.Editor.TextFieldLayout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/task_editor_hint_max">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/EditMaxPerRep"
                            style="@style/Widget.AISecretary.Editor.TextField"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
