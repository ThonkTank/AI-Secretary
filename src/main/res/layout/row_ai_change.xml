<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="11dp"
    android:background="@drawable/bg_leaf_middle_mirror"
    android:gravity="center_vertical"
    android:minHeight="82dp"
    android:orientation="horizontal">

    <View android:id="@+id/ChangeStripe" android:layout_width="4dp" android:layout_height="match_parent" android:background="@color/forest" />
    <CheckBox android:id="@+id/ChangeSelected" android:layout_width="48dp" android:layout_height="48dp" android:buttonTint="@color/forest" android:visibility="gone" />
    <TextView android:id="@+id/ChangeSymbol" android:layout_width="42dp" android:layout_height="match_parent" android:gravity="center" android:text="＋" android:textColor="@color/forest" android:textSize="22sp" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingTop="12dp" android:paddingEnd="18dp" android:paddingBottom="12dp">
        <TextView android:id="@+id/ChangeKind" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/newsreader_light_italic" android:text="neu" android:textColor="@color/forest" android:textSize="15sp" />
        <TextView android:id="@+id/ChangeTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/newsreader" android:textColor="@color/ink" android:textSize="20sp" />
        <TextView android:id="@+id/ChangeDetail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/ink_muted" android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
