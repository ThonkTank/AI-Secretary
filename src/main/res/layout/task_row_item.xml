<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/TaskRowRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/task_row_min_height"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginStart="@dimen/spacing_sm"
    android:layout_marginEnd="@dimen/spacing_sm"
    android:layout_marginBottom="@dimen/spacing_xs"
    android:background="@drawable/bg_task_row"
    android:paddingStart="@dimen/spacing_sm"
    android:paddingTop="@dimen/spacing_sm"
    android:paddingBottom="@dimen/spacing_sm"
    android:paddingEnd="@dimen/spacing_xs">

    <LinearLayout
        android:gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/StartTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Task.Time.Primary"/>

        <View
            android:id="@+id/TimeDivider"
            android:layout_width="match_parent"
            android:layout_height="@dimen/task_row_time_divider_height"
            android:background="@color/task_color_outline"/>

        <TextView
            android:id="@+id/EndTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/task_row_meta_spacing"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Task.Time.Secondary"/>
    </LinearLayout>

    <CheckBox
        android:id="@+id/TaskCheckBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:buttonTint="@color/task_color_primary"/>

    <TextView
        android:id="@+id/GoalIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/spacing_xs"
        android:textAppearance="@style/TextAppearance.Task.Title"
        android:visibility="gone"/>

    <LinearLayout
        android:id="@+id/ProgressContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/spacing_xs"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/ProgressMinusButton"
            android:layout_width="@dimen/task_row_progress_button_size"
            android:layout_height="@dimen/task_row_progress_button_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/task_progress_decrement"
            android:src="@android:drawable/ic_media_previous"
            android:tint="@color/task_progress_button_tint"/>

        <TextView
            android:id="@+id/ProgressText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_xs"
            android:layout_marginEnd="@dimen/spacing_xs"
            android:textAppearance="@style/TextAppearance.Task.Metadata"
            android:textColor="@color/task_progress_text"/>

        <ImageButton
            android:id="@+id/ProgressPlusButton"
            android:layout_width="@dimen/task_row_progress_button_size"
            android:layout_height="@dimen/task_row_progress_button_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/task_progress_increment"
            android:src="@android:drawable/ic_input_add"
            android:tint="@color/task_progress_button_tint"/>
    </LinearLayout>

    <TextView
        android:id="@+id/ExpandToggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/spacing_xs"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:importantForAccessibility="yes"
        android:minWidth="24dp"
        android:textAppearance="@style/TextAppearance.Task.Time.Primary"
        android:textColor="@color/task_color_on_surface_emphasis"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/TaskTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.Task.Title"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center_vertical|end"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_sm"
        android:paddingEnd="@dimen/spacing_xs">

        <TextView
            android:id="@+id/DeadlineCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Task.Metadata"/>

        <TextView
            android:id="@+id/StreakDisplay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/task_row_meta_spacing"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Task.Metadata"/>

        <TextView
            android:id="@+id/CalendarChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_calendar_chip"
            android:paddingStart="@dimen/spacing_sm"
            android:paddingTop="@dimen/spacing_xxs"
            android:paddingEnd="@dimen/spacing_sm"
            android:paddingBottom="@dimen/spacing_xxs"
            android:textAppearance="@style/TextAppearance.Task.Metadata"
            android:visibility="gone"/>
    </LinearLayout>

    <ImageButton
        android:id="@+id/TaskTimerButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_xs"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/task_timer_start"
        android:padding="@dimen/task_row_edit_button_padding"
        android:src="@android:drawable/ic_media_play"
        android:tint="@color/task_color_on_surface_emphasis"/>

    <ImageButton
        android:id="@+id/EditTaskButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_sm"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/task_row_edit"
        android:padding="@dimen/task_row_edit_button_padding"
        android:src="@drawable/ic_task_edit_24"
        android:tint="@color/task_color_on_surface_emphasis"/>
</LinearLayout>
