<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/task_row_min_height"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginStart="@dimen/spacing_sm"
    android:layout_marginEnd="@dimen/spacing_sm"
    android:layout_marginBottom="@dimen/spacing_xs"
    android:background="@drawable/bg_task_row"
    android:paddingStart="@dimen/spacing_sm"
    android:paddingTop="@dimen/spacing_sm"
    android:paddingBottom="@dimen/spacing_sm"
    android:paddingEnd="@dimen/spacing_xs">

    <LinearLayout
        android:gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/StartTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Task.Time.Primary"/>

        <View
            android:id="@+id/TimeDivider"
            android:layout_width="match_parent"
            android:layout_height="@dimen/task_row_time_divider_height"
            android:background="@color/task_row_time_divider"/>

        <TextView
            android:id="@+id/EndTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/task_row_meta_spacing"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Task.Time.Secondary"/>
    </LinearLayout>

    <CheckBox
        android:id="@+id/TaskCheckBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:buttonTint="@color/task_color_primary"/>

    <LinearLayout
        android:id="@+id/progress_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/spacing_xs"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btn_progress_minus"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/task_progress_decrement"
            android:src="@android:drawable/ic_media_previous"
            android:tint="@color/task_progress_button_tint"/>

        <TextView
            android:id="@+id/progress_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_xs"
            android:layout_marginEnd="@dimen/spacing_xs"
            android:textAppearance="@style/TextAppearance.Task.Metadata"
            android:textColor="@color/task_progress_text"/>

        <ImageButton
            android:id="@+id/btn_progress_plus"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/task_progress_increment"
            android:src="@android:drawable/ic_input_add"
            android:tint="@color/task_progress_button_tint"/>
    </LinearLayout>

    <TextView
        android:id="@+id/TaskTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.Task.Title"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center_vertical|end"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_sm"
        android:paddingEnd="@dimen/spacing_xs">

        <TextView
            android:id="@+id/DeadlineCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Task.Metadata"/>

        <TextView
            android:id="@+id/StreakDisplay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/task_row_meta_spacing"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Task.Metadata"/>
    </LinearLayout>

    <ImageButton
        android:id="@+id/EditTaskButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_sm"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/task_row_edit"
        android:padding="@dimen/task_row_edit_button_padding"
        android:src="@drawable/ic_task_edit_24"
        android:tint="@color/task_text_on_surface_emphasis"/>
</LinearLayout>
