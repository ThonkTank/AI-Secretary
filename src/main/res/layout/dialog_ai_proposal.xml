<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.autosecretary.ui.DaylightBackdropView android:layout_width="match_parent" android:layout_height="match_parent" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingTop="24dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="76dp" android:paddingEnd="22dp">
            <TextView android:id="@+id/ProposalBack" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:gravity="center_vertical" android:text="zurück" android:textColor="@color/ink_muted" android:textSize="17sp" />
            <TextView style="@style/WaldMarker" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Vorschlag" />
        </LinearLayout>

        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="60dp" android:paddingTop="12dp" android:paddingEnd="22dp" android:paddingBottom="24dp">
                <TextView android:id="@+id/ProposalWish" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/newsreader_extra_light" android:lineSpacingMultiplier="1.08" android:textColor="@color/ink" android:textSize="26sp" />
                <TextView android:id="@+id/ProposalSummary" style="@style/WaldMarker" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="17sp" />
                <LinearLayout android:id="@+id/ProposalChanges" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="vertical" />
                <TextView android:id="@+id/ProposalNothing" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_error_message" android:padding="14dp" android:text="Wähle mindestens eine Änderung aus." android:textColor="@color/danger" android:textSize="14sp" android:visibility="gone" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout android:layout_width="match_parent" android:layout_height="88dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="60dp" android:paddingEnd="22dp" android:paddingBottom="18dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/ProposalApply" android:layout_width="wrap_content" android:layout_height="52dp" android:text="Übernehmen" />
            <TextView android:id="@+id/ProposalDiscard" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginStart="12dp" android:gravity="center" android:paddingStart="8dp" android:paddingEnd="8dp" android:text="verwerfen" android:textColor="@color/ink_muted" android:textSize="17sp" />
            <TextView android:id="@+id/ProposalReview" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginStart="8dp" android:gravity="center" android:paddingStart="8dp" android:paddingEnd="8dp" android:text="einzeln prüfen" android:textColor="@color/forest" android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
