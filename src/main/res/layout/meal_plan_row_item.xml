<?xml version="1.0" encoding="utf-8"?>
<!-- Planned meal row. Inflated programmatically by MealPlannerPresenter into MealWeekList.
     Title = recipe name; Subtitle = date + meal type; Done button marks the meal consumed. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_sm"
    android:background="@color/meal_surface_overlay"
    android:orientation="horizontal"
    android:padding="@dimen/spacing_sm">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/MealPlanRowTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Body1"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/MealPlanRowSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Body2" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/MealPlanRowDone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/meal_mark_done" />
</LinearLayout>
