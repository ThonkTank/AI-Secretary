<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.autosecretary.ui.DaylightBackdropView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="76dp"
            android:paddingEnd="22dp">

            <TextView android:id="@+id/AiCancel" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:gravity="center_vertical" android:text="zurück" android:textColor="@color/ink_muted" android:textSize="17sp" />
            <TextView style="@style/WaldMarker" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="lokale KI" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="60dp"
                android:paddingTop="14dp"
                android:paddingEnd="22dp"
                android:paddingBottom="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_leaf_focus"
                    android:elevation="12dp"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:rotation="-0.7">

                    <TextView
                        style="@style/WaldMarker"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ein Wunsch"
                        android:textColor="@color/forest"
                        android:textSize="20sp" />

                    <EditText
                        android:id="@+id/AiInstruction"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:backgroundTint="@color/outline"
                        android:fontFamily="@font/newsreader_extra_light"
                        android:gravity="top|start"
                        android:hint="Wunsch eingeben …"
                        android:inputType="textCapSentences|textMultiLine"
                        android:minLines="4"
                        android:textColor="@color/ink"
                        android:textColorHint="@color/marker"
                        android:textSize="26sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Der Wunsch wird nur auf diesem Gerät gelesen. Nichts wird übernommen, bis du den Vorschlag freigibst."
                        android:textColor="@color/ink_muted"
                        android:textSize="15sp" />
                </LinearLayout>

                <TextView android:id="@+id/AiExampleOne" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/bg_leaf_middle" android:padding="16dp" android:text="Plane meine Uni-Aufgaben für diese Woche." android:textColor="@color/ink_secondary" android:textSize="15sp" />
                <TextView android:id="@+id/AiExampleTwo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_leaf_middle_mirror" android:padding="16dp" android:text="Lege eine Sonntagsroutine mit einzelnen Schritten an." android:textColor="@color/ink_secondary" android:textSize="15sp" />
                <TextView android:id="@+id/AiExampleThree" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_leaf_low" android:padding="16dp" android:text="Verschiebe alles Dringende vor Freitag." android:textColor="@color/ink_secondary" android:textSize="15sp" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="60dp"
            android:paddingEnd="22dp"
            android:paddingBottom="18dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/AiSubmit"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:text="Vorschlag lesen" />

            <TextView android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginStart="14dp" android:gravity="center" android:text="verwerfen" android:textColor="@color/ink_muted" android:textSize="17sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
