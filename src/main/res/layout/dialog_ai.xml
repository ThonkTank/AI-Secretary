<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_leaf_focus"
    android:orientation="vertical"
    android:padding="22dp">

    <EditText
        android:id="@+id/AiInstruction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dashed_leaf"
        android:fontFamily="serif"
        android:gravity="top|start"
        android:hint="Wunsch eingeben …"
        android:inputType="textCapSentences|textMultiLine"
        android:minLines="5"
        android:padding="18dp"
        android:textColor="@color/ink"
        android:textColorHint="@color/marker"
        android:textSize="22sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="10dp"
        android:text="Nichts wird übernommen, bis du den Vorschlag freigibst."
        android:textColor="@color/ink_muted"
        android:textSize="14sp" />
</LinearLayout>
