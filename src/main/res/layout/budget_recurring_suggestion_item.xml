<?xml version="1.0" encoding="utf-8"?>
<!-- Recurring transaction suggestion row. Inflated programmatically by
     BudgetRecurringSuggestionsDialogController into budget_recurring_suggestions_dialog.xml.
     Fields: Payee (bold name), Pattern (schedule description, e.g. "monthly on 1st"),
     Count (how many past occurrences detected), Confidence (0–100 % match quality), Amount. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="@dimen/spacing_sm"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <!-- click/focus disabled — the row root is the interactive element, not the checkbox -->
    <CheckBox
        android:id="@+id/BudgetSuggestionCheckbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="@dimen/spacing_sm">

        <TextView
            android:id="@+id/BudgetSuggestionPayee"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Body1"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/BudgetSuggestionPattern"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Body2" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/spacing_xxs">

            <TextView
                android:id="@+id/BudgetSuggestionCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Caption" />

            <TextView
                android:id="@+id/BudgetSuggestionConfidence"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_md"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Caption" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/BudgetSuggestionAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
        android:textStyle="bold" />
</LinearLayout>
