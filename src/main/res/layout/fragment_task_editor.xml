<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/spacing_lg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Basic Info -->
        <EditText
            android:id="@+id/EditTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Titel"/>

        <EditText
            android:id="@+id/EditDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Beschreibung"
            android:minLines="2"/>

        <Spinner
            android:id="@+id/EditPriority"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- Scheduling: Deadline -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/spacing_md">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Frist:"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/DeadlineInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_sm"
                app:endIconMode="custom"
                app:endIconDrawable="@android:drawable/ic_menu_my_calendar"
                app:endIconContentDescription="Frist auswählen">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/EditDeadline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:clickable="true"
                    android:longClickable="false"
                    android:inputType="none"
                    android:text="Keine Frist"
                    android:contentDescription="Frist auswählen"/>
            </com.google.android.material.textfield.TextInputLayout>

            <ImageButton
                android:id="@+id/ClearDeadline"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Frist löschen"/>
        </LinearLayout>

        <CheckBox
            android:id="@+id/EditCloseOnMiss"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bei Überschreitung schließen"/>

        <!-- Duration -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/spacing_sm">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dauer (Min):"/>

            <EditText
                android:id="@+id/EditMinDuration"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_sm"
                android:inputType="number"
                android:hint="Min"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" - "
                android:layout_marginStart="@dimen/spacing_xs"
                android:layout_marginEnd="@dimen/spacing_xs"/>

            <EditText
                android:id="@+id/EditMaxDuration"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="number"
                android:hint="Max"/>
        </LinearLayout>

        <!-- Cooldown -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/spacing_sm">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cooldown (Tage):"/>

            <EditText
                android:id="@+id/EditCooldown"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_sm"
                android:inputType="number"/>
        </LinearLayout>

        <!-- Repetition -->
        <CheckBox
            android:id="@+id/ToggleRepetition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="Wiederholung"/>

        <LinearLayout
            android:id="@+id/RepetitionContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone"
            android:paddingStart="@dimen/editor_section_indent">

            <EditText
                android:id="@+id/EditReps"
                android:layout_width="@dimen/compact_input_width"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:gravity="center"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" mal pro "
                android:layout_marginStart="@dimen/spacing_xs"
                android:layout_marginEnd="@dimen/spacing_xs"/>

            <EditText
                android:id="@+id/EditPerPeriod"
                android:layout_width="@dimen/compact_input_width"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:gravity="center"/>

            <Spinner
                android:id="@+id/EditPeriodUnit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_xs"/>
        </LinearLayout>

        <!-- PrefSlots -->
        <LinearLayout
            android:id="@+id/PrefSlotContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/spacing_sm"/>

        <CheckBox
            android:id="@+id/EditAdaptive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Adaptive Zeiten"/>

        <!-- Progress -->
        <CheckBox
            android:id="@+id/ToggleProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="Fortschritt"/>

        <LinearLayout
            android:id="@+id/ProgressContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingStart="@dimen/editor_section_indent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Einheit:"/>

                <EditText
                    android:id="@+id/EditUnit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:hint="z.B. Seiten"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ziel:"/>

                <EditText
                    android:id="@+id/EditTarget"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:inputType="number"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aktuell:"
                    android:layout_marginStart="@dimen/spacing_lg"/>

                <EditText
                    android:id="@+id/EditCurrent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:inputType="number"/>
            </LinearLayout>

            <CheckBox
                android:id="@+id/EditResetPerRep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Reset pro Wiederholung"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pro Wdh.:"/>

                <EditText
                    android:id="@+id/EditMinPerRep"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:inputType="number"
                    android:hint="Min"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" - "
                    android:layout_marginStart="@dimen/spacing_xs"
                    android:layout_marginEnd="@dimen/spacing_xs"/>

                <EditText
                    android:id="@+id/EditMaxPerRep"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:inputType="number"
                    android:hint="Max"/>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
