<?xml version="1.0" encoding="utf-8"?>
<!-- Shared temporal navigation bar: prev-chevron / centered label / next-chevron.
     Used by task_list_fragment.xml (day navigation) and budget_overview_fragment.xml (month navigation).
     The including fragment sets click listeners, label text, and content descriptions via view IDs.
     Note: consuming fragments MUST set contentDescription on NavPrev/NavNext (e.g. "Vorheriger Tag"). -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/TemporalNavBar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_temporal_nav_bar"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="@dimen/spacing_md"
    android:paddingVertical="@dimen/spacing_sm">

    <ImageButton
        android:id="@+id/NavPrev"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_chevron_left_24"
        android:scaleType="centerInside"
        app:tint="?attr/colorPrimary"
        android:contentDescription="@string/action_navigate_previous" />

    <TextView
        android:id="@+id/NavLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.AutoSecretary.Widget.NavLabel" />

    <ImageButton
        android:id="@+id/NavNext"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_chevron_right_24"
        android:scaleType="centerInside"
        app:tint="?attr/colorPrimary"
        android:contentDescription="@string/action_navigate_next" />
</LinearLayout>
