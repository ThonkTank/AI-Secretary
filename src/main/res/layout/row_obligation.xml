<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ObligationLeaf"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="11dp"
    android:background="@drawable/bg_leaf_middle"
    android:elevation="5dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingTop="14dp"
    android:paddingEnd="8dp"
    android:paddingBottom="14dp">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/RowDone"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/done"
        android:minWidth="48dp"
        android:text="○"
        android:textAllCaps="false"
        android:textColor="@color/outline"
        android:textSize="26sp"
        app:icon="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/RowGroup"
            style="@style/WaldMarker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="heute"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/RowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:textColor="@color/ink"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/RowMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/ink_muted"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/RowSteps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="vertical" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/RowOrder"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="Menü"
        android:minWidth="48dp"
        android:text="⋮"
        android:textAllCaps="false"
        android:textColor="@color/marker"
        android:textSize="21sp"
        app:icon="@null" />
</LinearLayout>
