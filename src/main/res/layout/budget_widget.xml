<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_forest_gradient"
    android:padding="@dimen/spacing_sm">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/budget_widget_title"
        android:textColor="@color/budget_widget_header_text"
        android:textStyle="bold"
        android:textSize="@dimen/task_text_md" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="@dimen/spacing_sm"
        android:padding="@dimen/spacing_sm"
        android:background="@drawable/bg_surface_card">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/budget_widget_total_label"
            android:textStyle="bold"
            android:textColor="@color/budget_widget_card_text"
            android:textSize="@dimen/task_text_xs" />

        <TextView
            android:id="@+id/budget_widget_total_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/budget_widget_card_text"
            android:textSize="@dimen/text_xl"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/budget_widget_free_label"
            android:textStyle="bold"
            android:textColor="@color/budget_widget_card_text"
            android:textSize="@dimen/task_text_xs" />

        <TextView
            android:id="@+id/budget_widget_free_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/budget_widget_card_text"
            android:textSize="@dimen/task_text_md" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/spacing_sm">

        <Button
            android:id="@+id/budget_widget_open_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/budget_widget_open" />

        <Button
            android:id="@+id/budget_widget_add_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_xs"
            android:text="@string/budget_widget_add" />
    </LinearLayout>

</LinearLayout>
