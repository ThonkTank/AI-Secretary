<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/task_widget_surface_secondary"
    android:padding="@dimen/spacing_sm">

    <!-- Day navigation header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="@dimen/spacing_xs">

        <TextView
            android:id="@+id/widget_prev_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/spacing_sm"
            android:text="@string/widget_day_nav_prev"
            android:textAppearance="@style/TextAppearance.Task.Widget.NavAction" />

        <TextView
            android:id="@+id/widget_date_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/widget_day_nav_today"
            android:textAppearance="@style/TextAppearance.Task.Widget.NavLabel" />

        <TextView
            android:id="@+id/widget_next_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/spacing_sm"
            android:text="@string/widget_day_nav_next"
            android:textAppearance="@style/TextAppearance.Task.Widget.NavAction" />
    </LinearLayout>

    <!-- Action bar: refresh -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:paddingBottom="@dimen/spacing_xs">

        <ImageButton
            android:id="@+id/widget_refresh"
            android:layout_width="@dimen/widget_refresh_button_size"
            android:layout_height="@dimen/widget_refresh_button_size"
            android:src="@android:drawable/ic_popup_sync"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/widget_refresh_content_description"
            android:scaleType="fitCenter" />
    </LinearLayout>

    <!-- Task list -->
    <ListView
        android:id="@+id/widget_task_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="@dimen/widget_list_divider_height" />

    <!-- Empty state -->
    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/widget_empty"
        android:textAppearance="@style/TextAppearance.Task.Metadata"
        android:visibility="gone" />

</LinearLayout>
