<?xml version="1.0" encoding="utf-8"?>
<!-- Budget transaction row. Inflated programmatically by BudgetOverviewLoader into
     BudgetTransactionList in budget_overview_fragment.xml.
     Accessibility: importantForAccessibility="yes" on the root groups label + amount into
     a single TalkBack announcement; children are set to "no" to avoid redundant reads. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="@dimen/spacing_sm"
    android:focusable="true"
    android:importantForAccessibility="yes">

    <TextView
        android:id="@+id/BudgetTransactionLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/budget_demo_transaction_label"
        android:textAppearance="@style/TextAppearance.MaterialComponents.Body1"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/BudgetTransactionAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/budget_demo_transaction_amount"
        android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
        android:textStyle="bold"
        android:importantForAccessibility="no" />

</LinearLayout>
