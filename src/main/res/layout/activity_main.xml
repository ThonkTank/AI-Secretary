<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/Root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.autosecretary.app.DaylightBackdropView
        android:id="@+id/DaylightBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="76dp"
            android:paddingEnd="22dp">

            <TextView
                android:id="@+id/Greeting"
                style="@style/WaldMarker"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Vormittag"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/ThemeMode"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Darstellung wechseln"
                android:gravity="center"
                android:text="◐"
                android:textColor="@color/marker"
                android:textSize="20sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/AddFab"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="＋"
                android:textColor="#182018"
                android:textSize="23sp"
                app:backgroundTint="@color/amber"
                app:cornerRadius="20dp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/TodayPanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="60dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="22dp"
                    android:paddingBottom="20dp">

                    <TextView
                        android:id="@+id/EmptyFocus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_dashed_leaf"
                        android:fontFamily="serif"
                        android:padding="26dp"
                        android:text="@string/empty_focus"
                        android:textColor="@color/ink"
                        android:textSize="26sp"
                        android:visibility="gone" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/FocusList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <LinearLayout
                        android:id="@+id/CalendarContext"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical" />

                    <LinearLayout
                        android:id="@+id/CalendarPermissionCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_dashed_leaf"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="serif"
                            android:text="Kalender als Umgebung"
                            android:textColor="@color/calendar_ink"
                            android:textSize="22sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Termine bleiben unverändert. Sie helfen nur dabei, echte freie Zeit zu finden."
                            android:textColor="@color/calendar_label"
                            android:textSize="15sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/CalendarPermissionAction"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Kalender freigeben" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <LinearLayout
                android:id="@+id/AllPanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="60dp"
                android:paddingTop="8dp"
                android:paddingEnd="22dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/AllHeading"
                    style="@style/WaldTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Alles" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView android:id="@+id/FilterOpen" style="@style/WaldMarker" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center" android:paddingEnd="22dp" android:text="offen" />
                    <TextView android:id="@+id/FilterRoutines" style="@style/WaldMarker" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center" android:paddingEnd="22dp" android:text="Routinen" />
                    <TextView android:id="@+id/FilterDone" style="@style/WaldMarker" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center" android:text="erledigt" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/ObligationList"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingBottom="18dp" />
            </LinearLayout>

            <androidx.core.widget.NestedScrollView
                android:id="@+id/AiPanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="60dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="22dp"
                    android:paddingBottom="24dp">

                    <TextView style="@style/WaldTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Lokale KI" />

                    <TextView
                        android:id="@+id/ModelStatus"
                        style="@style/WaldMarker"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/bg_leaf_focus"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="serif"
                            android:text="Was soll sich ändern?"
                            android:textColor="@color/ink"
                            android:textSize="27sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Ein Wunsch wird lokal gelesen. Du siehst jede vorgeschlagene Änderung, bevor etwas gespeichert wird."
                            android:textColor="@color/ink_muted"
                            android:textSize="16sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/AiBulkEdit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:text="Wunsch eingeben" />
                    </LinearLayout>

                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/bg_leaf_middle" android:padding="16dp" android:text="„Plane meine Uni-Aufgaben für diese Woche.“" android:textColor="@color/ink_secondary" android:textSize="15sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_leaf_low" android:padding="16dp" android:text="„Lege eine Sonntagsroutine mit einzelnen Schritten an.“" android:textColor="@color/ink_secondary" android:textSize="15sp" />

                    <TextView
                        android:id="@+id/SelectModel"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginTop="18dp"
                        android:gravity="center_vertical"
                        android:text="Gemma 3 270M · Modell austauschen"
                        android:textColor="@color/marker"
                        android:textSize="15sp" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="60dp"
            android:paddingEnd="22dp"
            android:paddingBottom="12dp">

            <TextView android:id="@+id/NavToday" android:layout_width="wrap_content" android:layout_height="48dp" android:gravity="center" android:paddingEnd="26dp" android:text="heute" android:textColor="@color/ink_secondary" android:textSize="17sp" />
            <TextView android:id="@+id/NavAll" android:layout_width="wrap_content" android:layout_height="48dp" android:gravity="center" android:paddingEnd="26dp" android:text="alles ansehen" android:textColor="@color/marker" android:textSize="17sp" />
            <TextView android:id="@+id/NavAi" android:layout_width="wrap_content" android:layout_height="48dp" android:gravity="center" android:text="lokale KI" android:textColor="@color/marker" android:textSize="17sp" />
        </LinearLayout>
    </LinearLayout>

    <com.autosecretary.app.CelebrationView
        android:id="@+id/Celebration"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:importantForAccessibility="no" />
</FrameLayout>
