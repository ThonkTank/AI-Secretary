<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" 
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <LinearLayout 
        android:layout_width="match_parent" 
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/Button"
            android:text="Generieren"/>

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            android:id="@+id/TaskListToggle"
            app:checkedButton="@+id/ChecklistButton">
            
            <com.google.android.material.button.MaterialButton 
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Checklist"
                android:id="@+id/ChecklistButton"
                style="?attr/materialButtonOutlinedStyle" />

            <com.google.android.material.button.MaterialButton 
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Manage"
                android:id="@+id/ManagementButton"
                style="?attr/materialButtonOutlinedStyle" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:id="@+id/TaskList"/>

    <LinearLayout
        android:id="@+id/EmptyStateContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/spacing_lg"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Noch keine Aufgaben"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6"
            android:textAlignment="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="Erstelle deine erste Aufgabe, um deinen Tagesplan zu starten"
            android:textAlignment="center" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/EmptyStateNewTaskButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="Erste Aufgabe erstellen" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/NewTaskButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_md"
        android:text="+ Neue Task"
        android:textSize="16sp"/>

</LinearLayout>
