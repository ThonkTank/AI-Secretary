<?xml version="1.0" encoding="utf-8"?>
<!-- Widget task row. Inflated by TaskWidgetRemoteViewsFactory for use in the task list
     RemoteViews widget (task_list_widget.xml). Sections: time column (start/end) →
     checkbox → title (weight=1) → streak. Text colours use widget-specific tint tokens
     since widget backgrounds differ from the in-app surface. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="@dimen/spacing_xs"
    android:background="@drawable/task_bg_row">

    <!-- Time column -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginEnd="@dimen/spacing_sm"
        android:minWidth="@dimen/widget_time_column_min_width">

        <TextView
            android:id="@+id/WidgetRowStart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Task.Time.Primary"
            android:textColor="@color/task_widget_text_secondary" />

        <TextView
            android:id="@+id/WidgetRowEnd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Task.Time.Secondary"
            android:textColor="@color/task_widget_text_muted" />
    </LinearLayout>

    <!-- Checkbox -->
    <CheckBox
        android:id="@+id/WidgetRowCheckbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/spacing_xs"
        android:focusable="false" />

    <!-- Title -->
    <TextView
        android:id="@+id/WidgetRowTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Task.Title"
        android:textColor="@color/task_widget_text_primary" />

    <!-- Streak -->
    <TextView
        android:id="@+id/WidgetRowStreak"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_xs"
        android:textAppearance="@style/TextAppearance.Task.Metadata"
        android:textColor="@color/task_widget_text_muted" />

</LinearLayout>
