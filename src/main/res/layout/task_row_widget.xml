<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="@dimen/spacing_xs"
    android:background="@drawable/bg_task_row">

    <!-- Time column -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginEnd="@dimen/spacing_sm"
        android:minWidth="@dimen/widget_time_column_min_width">

        <TextView
            android:id="@+id/widget_row_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Task.Time.Primary"
            android:textColor="@color/task_widget_text_secondary" />

        <TextView
            android:id="@+id/widget_row_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Task.Time.Secondary"
            android:textColor="@color/task_widget_text_muted" />
    </LinearLayout>

    <!-- Checkbox -->
    <CheckBox
        android:id="@+id/widget_row_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/spacing_xs"
        android:focusable="false" />

    <!-- Title -->
    <TextView
        android:id="@+id/widget_row_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Task.Title"
        android:textColor="@color/task_widget_text_primary" />

    <!-- Streak -->
    <TextView
        android:id="@+id/widget_row_streak"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_xs"
        android:textAppearance="@style/TextAppearance.Task.Metadata"
        android:textColor="@color/task_widget_text_muted" />

</LinearLayout>
