<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_leaf_focus"
        android:orientation="vertical"
        android:padding="22dp">

        <EditText
            android:id="@+id/EditTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/outline"
            android:fontFamily="serif"
            android:hint="@string/title_hint"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="3"
            android:textColor="@color/ink"
            android:textColorHint="@color/marker"
            android:textSize="28sp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="geschätzte Dauer" android:textColor="@color/marker" android:textSize="15sp" />
        <EditText
            android:id="@+id/EditDuration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/outline"
            android:hint="@string/duration_hint"
            android:inputType="number"
            android:textColor="@color/ink"
            android:textColorHint="@color/marker" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Tageszeitpräferenz" android:textColor="@color/marker" android:textSize="15sp" />
        <Spinner
            android:id="@+id/EditTimePreference"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:entries="@array/time_preferences" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/EditFlexible"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="flexibel · aus Verhalten lernen"
            android:textColor="@color/ink_secondary"
            android:textSize="16sp"
            app:useMaterialThemeColors="true" />

        <LinearLayout
            android:id="@+id/TaskFields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Deadline · Datum und optionale Uhrzeit" android:textColor="@color/marker" android:textSize="15sp" />
            <EditText
                android:id="@+id/EditDeadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/outline"
                android:focusable="false"
                android:hint="@string/deadline_hint"
                android:inputType="text"
                android:textColor="@color/ink"
                android:textColorHint="@color/marker" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/RoutineFields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Rhythmus" android:textColor="@color/marker" android:textSize="15sp" />
            <EditText android:id="@+id/EditCadence" android:layout_width="match_parent" android:layout_height="wrap_content" android:backgroundTint="@color/outline" android:hint="@string/cadence_hint" android:inputType="number" android:textColor="@color/ink" android:textColorHint="@color/marker" />
            <EditText android:id="@+id/EditNextDue" android:layout_width="match_parent" android:layout_height="wrap_content" android:backgroundTint="@color/outline" android:focusable="false" android:hint="@string/next_due_hint" android:inputType="text" android:textColor="@color/ink" android:textColorHint="@color/marker" />
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Schritte" android:textColor="@color/marker" android:textSize="15sp" />
        <EditText
            android:id="@+id/EditSteps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dashed_leaf"
            android:gravity="top|start"
            android:hint="@string/steps_hint"
            android:inputType="textCapSentences|textMultiLine"
            android:minLines="4"
            android:padding="16dp"
            android:textColor="@color/ink"
            android:textColorHint="@color/marker" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:text="@string/steps_help"
            android:textColor="@color/ink_muted"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
