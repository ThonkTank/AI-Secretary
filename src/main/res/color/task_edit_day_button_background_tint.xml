<?xml version="1.0" encoding="utf-8"?>
<!--
  Task day picker button background color states.

  Used by:
  - Widget.AISecretary.TaskEdit.DayPickerButton (day selection buttons in task editor)

  This selector coordinates with task_button_text_color.xml and
  task_edit_day_button_stroke_color.xml — all three use the same state
  matching order (disabled → checked → default). If state behavior needs
  to change, all three files must be updated together.

  State matching is first-match-wins in Android selectors.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/task_edit_day_disabled_background" />
    <item android:state_checked="true" android:color="@color/task_edit_day_selected_background" />
    <item android:color="@color/task_edit_day_unselected_background" />
</selector>
