<?xml version="1.0" encoding="utf-8"?>
<!-- Button text color states: disabled → checked → default.

     Used by:
     - Widget.AISecretary.TaskEdit.DayPickerButton (day selection buttons)
     - Widget.AISecretary.BottomNavigation (primary navigation)

     Color scheme defined in task_colors.xml. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/task_color_primary_disabled_50" />
    <item android:state_checked="true" android:color="@color/task_color_on_primary" />
    <item android:color="@color/task_color_primary" />
</selector>
