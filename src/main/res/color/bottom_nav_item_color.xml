<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom navigation item color states: disabled → checked → default.

     Uses primary-variant for the selected state so the active tab is clearly
     visible on the light card surface background (color_on_primary would
     be near-invisible there).

     Color scheme defined in colors.xml. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/color_primary_disabled_50" />
    <item android:state_checked="true" android:color="@color/color_primary_variant" />
    <item android:color="@color/color_primary" />
</selector>
