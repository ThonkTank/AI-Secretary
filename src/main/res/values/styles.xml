<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AutoSecretary" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/forest</item>
        <item name="colorPrimaryVariant">@color/forest</item>
        <item name="colorSecondary">@color/amber</item>
        <item name="android:fontFamily">@font/alegreya_sans</item>
        <item name="fontFamily">@font/alegreya_sans</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/mist</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/mist</item>
        <item name="materialButtonStyle">@style/WaldButton</item>
        <item name="alertDialogTheme">@style/WaldDialog</item>
    </style>

    <style name="WaldDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="android:fontFamily">@font/alegreya_sans</item>
        <item name="colorPrimary">@color/forest</item>
        <item name="android:windowBackground">@drawable/bg_leaf_focus</item>
    </style>

    <style name="WaldButton" parent="Widget.MaterialComponents.Button">
        <item name="android:fontFamily">@font/alegreya_sans</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">26dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/action_text</item>
    </style>

    <style name="WaldMarker">
        <item name="android:fontFamily">@font/newsreader_light_italic</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/marker</item>
    </style>

    <style name="WaldTitle">
        <item name="android:fontFamily">@font/newsreader_extra_light</item>
        <item name="android:textSize">32sp</item>
        <item name="android:lineSpacingMultiplier">1.06</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="WaldLeafTitle">
        <item name="android:fontFamily">@font/newsreader</item>
        <item name="android:textSize">23sp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="WaldChoiceChip" parent="Widget.MaterialComponents.Chip.Filter">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:fontFamily">@font/alegreya_sans</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/wald_choice_chip_text</item>
        <item name="chipBackgroundColor">@color/wald_choice_chip_background</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipMinHeight">40dp</item>
        <item name="chipStrokeColor">@color/outline</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="ensureMinTouchTargetSize">false</item>
    </style>

    <style name="WaldDayChip" parent="Widget.MaterialComponents.Chip.Filter">
        <item name="android:layout_width">38dp</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:fontFamily">@font/alegreya_sans</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/wald_choice_chip_text</item>
        <item name="chipBackgroundColor">@color/wald_choice_chip_background</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipCornerRadius">19dp</item>
        <item name="chipMinHeight">38dp</item>
        <item name="chipStartPadding">0dp</item>
        <item name="chipEndPadding">0dp</item>
        <item name="textStartPadding">0dp</item>
        <item name="textEndPadding">0dp</item>
        <item name="chipStrokeColor">@color/outline</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="ensureMinTouchTargetSize">false</item>
    </style>

    <style name="WaldEditorDialog" parent="Theme.AutoSecretary">
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
