<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material Design theme and component styles.

         Naming convention: [Widget|TextAppearance].[Namespace].[Component].[Variant]
         - Widget.* for view styles (buttons, inputs, spinners, navigation)
         - TextAppearance.* for text properties (color, size, weight, font)
         - Parent: always inherit from Material parent (Widget.MaterialComponents.*, TextAppearance.MaterialComponents.*)

         AppTheme: Material Light theme with nature-inspired colors + forest gradient background.
         Colors from colors.xml; dimens from ../dimens.xml and ../task_dimens.xml.

         When adding new styles:
         1. Inherit from Material parent: Widget.MaterialComponents.Button.Outlined, etc.
         2. Reference color/dimen tokens (never inline hex/dp values)
         3. Follow naming: Widget.AutoSecretary.[Component].[Variant]
            For text: TextAppearance.AutoSecretary.[Feature].[Role] (e.g. TextAppearance.AutoSecretary.Task.Title)
         4. Place styles logically (theme first, then component groups)

         Reference: https://material.io/develop/android (Material Components for Android — MDC2;
                   matches Widget.MaterialComponents.* and TextAppearance.MaterialComponents.*)
                  https://m3.material.io/ (Material Design 3 design system guidelines;
                   note: this codebase uses MDC2 View-based components, not the M3/Compose API)
    -->

    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorPrimaryVariant">@color/color_primary_variant</item>
        <item name="colorOnPrimary">@color/color_on_primary</item>
        <item name="colorSecondary">@color/color_secondary</item>
        <item name="colorSurface">@color/color_surface</item>
        <item name="android:colorBackground">@color/color_background</item>
        <item name="colorOnSurface">@color/color_on_surface</item>
        <item name="colorOutline">@color/color_outline</item>
        <item name="android:windowBackground">@drawable/bg_forest_gradient</item>
        <item name="bottomNavigationStyle">@style/Widget.AutoSecretary.BottomNavigation</item>
    </style>

    <style name="Widget.AutoSecretary.BottomNavigation" parent="Widget.MaterialComponents.BottomNavigationView.Colored">
        <item name="android:background">@drawable/bg_surface_card</item>
        <item name="itemIconTint">@color/bottom_nav_item_color</item>
        <item name="itemTextColor">@color/bottom_nav_item_color</item>
    </style>

    <!-- Toggle buttons used in MaterialButtonToggleGroup (task Checklist/Manage, meal sub-tabs) -->
    <style name="Widget.AutoSecretary.ToggleButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Day picker buttons -->
    <style name="Widget.AutoSecretary.TaskEdit.DayPickerButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/task_button_text_color</item>
        <item name="backgroundTint">@color/task_edit_day_button_background_tint</item>
        <item name="strokeColor">@color/task_edit_day_button_stroke_color</item>
        <item name="cornerRadius">@dimen/corner_radius_sm</item>
    </style>

    <!-- Shared row primary text appearance: the standard text treatment for the main label
         in any list row (task, budget, meal). 16sp (Body1), no bold, on-surface color.
         Feature-specific row titles should inherit from this for consistency. -->
    <style name="TextAppearance.AutoSecretary.RowPrimary" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/color_on_surface</item>
    </style>

    <!-- Empty state text appearances (used when a list has no items to display). -->
    <style name="TextAppearance.AutoSecretary.EmptyState.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/color_on_surface</item>
    </style>
    <style name="TextAppearance.AutoSecretary.EmptyState.Subtitle" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/color_on_surface_variant</item>
    </style>

    <!-- Base task text appearances.
         TextAppearance.AutoSecretary.Task is a named inheritance root: all task text styles extend it
         (e.g. TextAppearance.AutoSecretary.Task.Title, TextAppearance.AutoSecretary.Task.Metadata). Inheriting from this
         name rather than repeating the Material parent directly keeps the hierarchy explicit. -->
    <style name="TextAppearance.AutoSecretary.Task" parent="TextAppearance.MaterialComponents.Body2" />

    <!-- Task editor inputs -->
    <style name="Widget.AutoSecretary.Editor.TextFieldLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
        <item name="boxBackgroundMode">outline</item>
        <item name="boxStrokeColor">@color/color_outline</item>
        <item name="boxBackgroundColor">@color/color_surface</item>
        <item name="boxStrokeWidth">@dimen/editor_input_stroke_width</item>
        <item name="boxStrokeWidthFocused">@dimen/editor_input_stroke_width_focused</item>
    </style>

    <style name="Widget.AutoSecretary.Editor.TextField" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox.Dense">
        <item name="android:minHeight">@dimen/touch_target_min</item>
    </style>

    <style name="TextAppearance.AutoSecretary.Editor.Label" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">@dimen/text_sm</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/color_on_surface_emphasis</item>
    </style>

    <!-- Section header: used to introduce a new logical group in multi-section forms.
         Visually distinct from Editor.Label (which labels individual fields).
         12sp, uppercase, muted variant color — follows Material "overline" convention. -->
    <style name="TextAppearance.AutoSecretary.Editor.SectionHeader" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">@dimen/text_xs</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/color_on_surface_variant</item>
    </style>

    <style name="TextAppearance.AutoSecretary.Editor.PrefSlotButton" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">@dimen/text_sm</item>
    </style>

    <style name="Widget.AutoSecretary.Editor.Spinner" parent="Widget.AppCompat.Spinner">
        <item name="android:background">@drawable/bg_spinner_outline</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:paddingStart">@dimen/spacing_sm</item>
        <item name="android:paddingEnd">@dimen/spacing_sm</item>
    </style>

    <style name="Widget.AutoSecretary.Editor.SpinnerLabel" parent="TextAppearance.AutoSecretary.Editor.Label">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="Widget.AutoSecretary.Editor.SpinnerField" parent="Widget.AutoSecretary.Editor.Spinner">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/spacing_xs</item>
    </style>

    <style name="Widget.AutoSecretary.Editor.RangeRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="Widget.AutoSecretary.Editor.RangeSeparator" parent="TextAppearance.AutoSecretary.Editor.Label">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/spacing_xs</item>
        <item name="android:layout_marginEnd">@dimen/spacing_xs</item>
    </style>

    <!-- Task text appearances -->
    <style name="TextAppearance.AutoSecretary.Task.Title" parent="TextAppearance.AutoSecretary.RowPrimary" />

    <style name="TextAppearance.AutoSecretary.Task.Metadata" parent="TextAppearance.AutoSecretary.Task">
        <item name="android:textSize">@dimen/text_xs</item>
        <item name="android:textColor">@color/color_on_surface_variant</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <style name="TextAppearance.AutoSecretary.Task.Time.Primary" parent="TextAppearance.AutoSecretary.Task.Metadata">
        <item name="android:textColor">@color/color_on_surface_emphasis</item>
    </style>

    <style name="TextAppearance.AutoSecretary.Task.Time.Secondary" parent="TextAppearance.AutoSecretary.Task.Metadata">
        <item name="android:textColor">@color/color_on_surface_muted</item>
    </style>

    <style name="TextAppearance.AutoSecretary.Task.Widget.NavAction" parent="TextAppearance.AutoSecretary.Task">
        <item name="android:textSize">@dimen/text_md</item>
        <item name="android:textColor">@color/color_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.AutoSecretary.Widget.NavLabel" parent="TextAppearance.AutoSecretary.Task.Title">
        <item name="android:textSize">@dimen/text_md</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Budget widget text appearances -->
    <style name="TextAppearance.AutoSecretary.Budget.Widget.Header" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">@dimen/text_md</item>
        <item name="android:textColor">@color/budget_widget_header_text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.AutoSecretary.Budget.Widget.CardLabel" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">@dimen/text_xs</item>
        <item name="android:textColor">@color/budget_widget_card_text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.AutoSecretary.Budget.Widget.CardValue" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">@dimen/text_lg</item>
        <item name="android:textColor">@color/budget_widget_card_text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.AutoSecretary.Budget.Widget.CardValueSecondary" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">@dimen/text_md</item>
        <item name="android:textColor">@color/budget_widget_card_text</item>
    </style>

    <!-- Shared section title style used in meal and budget overview screens. -->
    <style name="TextAppearance.AutoSecretary.SectionTitle" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">@dimen/text_md</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/color_on_surface</item>
    </style>

    <!-- Meal row item text appearances (used in meal_plan_row_item.xml, meal_text_row_item.xml) -->
    <style name="TextAppearance.AutoSecretary.Meal.RowTitle" parent="TextAppearance.AutoSecretary.RowPrimary" />

    <style name="TextAppearance.AutoSecretary.Meal.RowSubtitle" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/color_on_surface_variant</item>
    </style>

    <style name="TextAppearance.AutoSecretary.Meal.RowBody" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/color_on_surface</item>
    </style>

    <!-- Budget non-widget text appearances (overview, transaction rows, limit bars, suggestions) -->
    <style name="TextAppearance.AutoSecretary.Budget.RowLabel" parent="TextAppearance.AutoSecretary.RowPrimary" />

    <style name="TextAppearance.AutoSecretary.Budget.RowValue" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.AutoSecretary.Budget.RowSecondary" parent="TextAppearance.MaterialComponents.Body2" />

    <style name="TextAppearance.AutoSecretary.Budget.RowSecondaryBold" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.AutoSecretary.Budget.Caption" parent="TextAppearance.MaterialComponents.Caption" />

    <style name="TextAppearance.AutoSecretary.Budget.CaptionBold" parent="TextAppearance.AutoSecretary.Budget.Caption">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.AutoSecretary.Budget.SummaryTotal" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.AutoSecretary.Budget.SummaryRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="Widget.AutoSecretary.Budget.SummaryRow.Spaced" parent="Widget.AutoSecretary.Budget.SummaryRow">
        <item name="android:layout_marginTop">@dimen/spacing_sm</item>
    </style>

    <style name="Widget.AutoSecretary.Budget.SummaryLabel" parent="TextAppearance.AutoSecretary.Budget.RowLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
    </style>

    <style name="Widget.AutoSecretary.Budget.SummaryValue" parent="TextAppearance.AutoSecretary.Budget.RowValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="Widget.AutoSecretary.Budget.SummaryTotalLabel" parent="TextAppearance.AutoSecretary.Budget.SummaryTotal">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
    </style>

    <style name="Widget.AutoSecretary.Budget.SummaryTotalValue" parent="TextAppearance.AutoSecretary.Budget.SummaryTotal">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

</resources>
