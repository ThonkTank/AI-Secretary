<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/task_color_primary</item>
        <item name="colorPrimaryVariant">@color/task_color_primary_variant</item>
        <item name="colorOnPrimary">@color/task_color_on_primary</item>
        <item name="colorSecondary">@color/task_color_secondary</item>
        <item name="colorSurface">@color/task_color_surface</item>
        <item name="android:colorBackground">@color/task_color_background</item>
        <item name="colorOnSurface">@color/task_color_on_surface</item>
        <item name="colorOutline">@color/task_color_outline</item>
        <item name="android:windowBackground">@drawable/bg_forest_gradient</item>
        <item name="bottomNavigationStyle">@style/Widget.AISecretary.BottomNavigation</item>
    </style>

    <style name="Widget.AISecretary.BottomNavigation" parent="Widget.MaterialComponents.BottomNavigationView.Colored">
        <item name="android:background">@drawable/bg_surface_card</item>
        <item name="itemIconTint">@color/task_edit_day_button_text_color</item>
        <item name="itemTextColor">@color/task_edit_day_button_text_color</item>
    </style>

    <!-- Day picker buttons -->
    <style name="Widget.AISecretary.TaskEdit.DayPickerButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/task_edit_day_button_text_color</item>
        <item name="backgroundTint">@color/task_edit_day_button_background_tint</item>
        <item name="strokeColor">@color/task_edit_day_button_stroke_color</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Base task text appearances -->
    <style name="TextAppearance.Task" parent="TextAppearance.MaterialComponents.Body2" />
    <style name="TextAppearance.Task.Widget" parent="TextAppearance.Task" />

    <!-- Task editor inputs -->
    <style name="Widget.AISecretary.Editor.TextFieldLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
        <item name="boxBackgroundMode">outline</item>
        <item name="boxStrokeColor">@color/task_color_outline</item>
        <item name="boxBackgroundColor">@color/task_color_surface</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
    </style>

    <style name="Widget.AISecretary.Editor.TextField" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox.Dense">
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="TextAppearance.AISecretary.Editor.Label" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/task_color_on_surface_emphasis</item>
    </style>

    <style name="TextAppearance.AISecretary.Editor.PrefSlotButton" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">@dimen/task_editor_pref_slot_button_text_size</item>
    </style>

    <style name="Widget.AISecretary.Editor.Spinner" parent="Widget.AppCompat.Spinner">
        <item name="android:background">@drawable/editor_selector_background</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">@dimen/spacing_sm</item>
        <item name="android:paddingEnd">@dimen/spacing_sm</item>
    </style>

    <!-- Task text appearances -->
    <style name="TextAppearance.Task.Title">
        <item name="android:textSize">@dimen/task_text_sm</item>
        <item name="android:textColor">@color/task_color_on_surface</item>
    </style>

    <style name="TextAppearance.Task.Metadata">
        <item name="android:textSize">@dimen/task_text_xs</item>
        <item name="android:textColor">@color/task_color_on_surface_variant</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <style name="TextAppearance.Task.Time.Primary" parent="TextAppearance.Task.Metadata">
        <item name="android:textColor">@color/task_color_on_surface_emphasis</item>
    </style>

    <style name="TextAppearance.Task.Time.Secondary" parent="TextAppearance.Task.Metadata">
        <item name="android:textColor">@color/task_color_on_surface_muted</item>
    </style>

    <style name="TextAppearance.Task.Widget.NavAction">
        <item name="android:textSize">@dimen/task_text_md</item>
        <item name="android:textColor">@color/task_color_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Task.Widget.NavLabel" parent="TextAppearance.Task.Title">
        <item name="android:textSize">@dimen/task_text_md</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Task.Widget.NewTaskCta">
        <item name="android:textSize">@dimen/task_text_md</item>
    </style>
</resources>
