<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material Design theme and component styles.

         Naming convention: [Widget|TextAppearance].[Namespace].[Component].[Variant]
         - Widget.* for view styles (buttons, inputs, spinners, navigation)
         - TextAppearance.* for text properties (color, size, weight, font)
         - Parent: always inherit from Material parent (Widget.MaterialComponents.*, TextAppearance.MaterialComponents.*)

         AppTheme: Material Light theme with nature-inspired task colors + forest gradient background.
         Colors from ../task_colors.xml; dimens from ../dimens.xml and ../task_dimens.xml.

         When adding new styles:
         1. Inherit from Material parent: Widget.MaterialComponents.Button.Outlined, etc.
         2. Reference color/dimen tokens (never inline hex/dp values)
         3. Follow naming: Widget.AutoSecretary.[Component].[Variant]
         4. Place styles logically (theme first, then component groups)

         Reference: https://m3.material.io/ (Material Design 3 guidelines)
                   https://material.io/develop/android (Material Components for Android)
    -->

    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/task_color_primary</item>
        <item name="colorPrimaryVariant">@color/task_color_primary_variant</item>
        <item name="colorOnPrimary">@color/task_color_on_primary</item>
        <item name="colorSecondary">@color/task_color_secondary</item>
        <item name="colorSurface">@color/task_color_surface</item>
        <item name="android:colorBackground">@color/task_color_background</item>
        <item name="colorOnSurface">@color/task_color_on_surface</item>
        <item name="colorOutline">@color/task_color_outline</item>
        <item name="android:windowBackground">@drawable/bg_forest_gradient</item>
        <item name="bottomNavigationStyle">@style/Widget.AutoSecretary.BottomNavigation</item>
    </style>

    <style name="Widget.AutoSecretary.BottomNavigation" parent="Widget.MaterialComponents.BottomNavigationView.Colored">
        <item name="android:background">@drawable/bg_surface_card</item>
        <item name="itemIconTint">@color/task_button_text_color</item>
        <item name="itemTextColor">@color/task_button_text_color</item>
    </style>

    <!-- Day picker buttons -->
    <style name="Widget.AutoSecretary.TaskEdit.DayPickerButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/task_button_text_color</item>
        <item name="backgroundTint">@color/task_edit_day_button_background_tint</item>
        <item name="strokeColor">@color/task_edit_day_button_stroke_color</item>
        <item name="cornerRadius">@dimen/task_corner_radius_sm</item>
    </style>

    <!-- Base task text appearances -->
    <style name="TextAppearance.Task" parent="TextAppearance.MaterialComponents.Body2" />

    <!-- Task editor inputs -->
    <style name="Widget.AutoSecretary.Editor.TextFieldLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
        <item name="boxBackgroundMode">outline</item>
        <item name="boxStrokeColor">@color/task_color_outline</item>
        <item name="boxBackgroundColor">@color/task_color_surface</item>
        <item name="boxStrokeWidth">@dimen/task_editor_input_stroke_width</item>
        <item name="boxStrokeWidthFocused">@dimen/task_editor_input_stroke_width_focused</item>
    </style>

    <style name="Widget.AutoSecretary.Editor.TextField" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox.Dense">
        <item name="android:minHeight">@dimen/task_editor_input_min_height</item>
    </style>

    <style name="TextAppearance.AutoSecretary.Editor.Label" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">@dimen/text_sm</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/task_color_on_surface_emphasis</item>
    </style>

    <style name="TextAppearance.AutoSecretary.Editor.PrefSlotButton" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">@dimen/task_editor_pref_slot_button_text_size</item>
    </style>

    <style name="Widget.AutoSecretary.Editor.Spinner" parent="Widget.AppCompat.Spinner">
        <item name="android:background">@drawable/task_editor_selector_background</item>
        <item name="android:minHeight">@dimen/task_editor_input_min_height</item>
        <item name="android:paddingStart">@dimen/spacing_sm</item>
        <item name="android:paddingEnd">@dimen/spacing_sm</item>
    </style>

    <!-- Task text appearances -->
    <style name="TextAppearance.Task.Title" parent="TextAppearance.Task">
        <item name="android:textSize">@dimen/text_sm</item>
        <item name="android:textColor">@color/task_color_on_surface</item>
    </style>

    <style name="TextAppearance.Task.Metadata" parent="TextAppearance.Task">
        <item name="android:textSize">@dimen/text_xs</item>
        <item name="android:textColor">@color/task_color_on_surface_variant</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <style name="TextAppearance.Task.Time.Primary" parent="TextAppearance.Task.Metadata">
        <item name="android:textColor">@color/task_color_on_surface_emphasis</item>
    </style>

    <style name="TextAppearance.Task.Time.Secondary" parent="TextAppearance.Task.Metadata">
        <item name="android:textColor">@color/task_color_on_surface_muted</item>
    </style>

    <style name="TextAppearance.Task.Widget.NavAction" parent="TextAppearance.Task">
        <item name="android:textSize">@dimen/text_md</item>
        <item name="android:textColor">@color/task_color_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Task.Widget.NavLabel" parent="TextAppearance.Task.Title">
        <item name="android:textSize">@dimen/text_md</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Task.Widget.NewTaskCta" parent="TextAppearance.Task">
        <item name="android:textSize">@dimen/text_md</item>
    </style>

    <!-- Budget widget text appearances -->
    <style name="TextAppearance.Budget.Widget.Header" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">@dimen/text_md</item>
        <item name="android:textColor">@color/budget_widget_header_text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Budget.Widget.CardLabel" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">@dimen/text_xs</item>
        <item name="android:textColor">@color/budget_widget_card_text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Budget.Widget.CardValue" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">@dimen/text_xl</item>
        <item name="android:textColor">@color/budget_widget_card_text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Budget.Widget.CardValueSecondary" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">@dimen/text_md</item>
        <item name="android:textColor">@color/budget_widget_card_text</item>
    </style>

    <!-- Meal feature text appearances -->
    <style name="TextAppearance.Meal.SectionTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">@dimen/text_md</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/task_color_on_surface</item>
    </style>

    <style name="TextAppearance.Meal.DialogLabel" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/text_sm</item>
    </style>
</resources>
