<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Task feature color palette (Material Design tokens + semantic colors).
         Nature-inspired base: greens, earth tones, warm accents supporting calm focus and visual hierarchy.
         Primary color (task_color_primary = #FF5C7A4D) is the source for all derived tokens.
         When changing primary: update task_color_primary_variant, on_primary, alpha-composited variants (lines 27-30),
         and AppTheme colorPrimary in ../styles.xml.
         For new colors: use semantic names (task_[domain]_[status]) or Material role names (task_color_[role]).
         See ../README.md for color naming conventions. -->

    <!-- Nature-inspired base palette -->
    <color name="task_color_background">#FFF4F1E8</color>
    <color name="task_color_surface">#FFFFFCF6</color>
    <color name="task_color_surface_variant">#FFF0E8D6</color>
    <color name="task_color_on_surface">#FF2F3A2C</color>
    <color name="task_color_on_surface_variant">#FF5F6C58</color>
    <color name="task_color_on_surface_emphasis">#FF3F4D3A</color>
    <color name="task_color_on_surface_muted">#FF7E8878</color>
    <color name="task_color_outline">#FFC5BFAF</color>

    <color name="task_color_primary">#FF5C7A4D</color>
    <color name="task_color_primary_variant">#FF49653D</color>
    <color name="task_color_on_primary">#FFF8F6EE</color>
    <color name="task_color_secondary">#FF8DAA8C</color>
    <color name="task_color_accent">#FFCF8F4F</color>

    <!-- Day picker colors -->
    <color name="task_edit_day_selected_background">@color/task_color_primary</color>
    <color name="task_edit_day_selected_text">@color/task_color_on_primary</color>
    <color name="task_edit_day_selected_stroke">@color/task_color_primary</color>
    <color name="task_edit_day_unselected_background">@color/transparent</color>
    <color name="task_edit_day_unselected_text">@color/task_color_primary</color>
    <color name="task_edit_day_unselected_stroke">@color/task_color_outline</color>

    <!-- Alpha-composited variants of task_color_primary (#FF5C7A4D): 8%, 50%, 25% opacity.
         Hex format: #(opacityHex)(colorHexWithoutAlpha). Opacity percentages:
         - 8% disabled background = 0x14 alpha
         - 50% disabled text = 0x80 alpha
         - 25% disabled stroke = 0x40 alpha
         If task_color_primary changes, recalculate all three opacities using the new color hex (without #FF).
         Quick method: multiply opacity % by 255, convert to hex (e.g., 0.08*255 = 20.4 ≈ 0x14).
         Or use a design tool (Figma, Material Theme Builder) to export alpha variants.
         Reference: https://stackoverflow.com/questions/15852122/hex-transparency-in-colors -->
    <color name="task_edit_day_disabled_background">#145C7A4D</color>
    <color name="task_edit_day_disabled_text">#805C7A4D</color>
    <color name="task_edit_day_disabled_stroke">#405C7A4D</color>

    <!-- Deadline urgency colors -->
    <color name="task_deadline_overdue">#FFB4543A</color>
    <color name="task_deadline_soon">#FFC47E42</color>
    <color name="task_deadline_future">@color/task_color_on_surface_variant</color>

    <!-- Streak rarity tiers -->
    <color name="task_streak_common">@color/task_color_on_surface_muted</color>
    <color name="task_streak_rare">@color/task_color_primary</color>
    <color name="task_streak_epic">#FF7A4DA8</color>
    <color name="task_streak_legendary">#FFCF8F4F</color>

    <color name="task_completion_flash">#66CF8F4F</color>
    <color name="task_completed_background">#245C7A4D</color>
    <color name="task_completed_checkbox_tint">@color/task_color_primary</color>
    <color name="task_in_progress_background">#1F5C7A4D</color>
    <color name="task_in_progress_checkbox_tint">@color/task_color_primary</color>
    <color name="task_progress_text">@color/task_color_on_surface_emphasis</color>
    <color name="task_progress_text_disabled">@color/task_color_on_surface_muted</color>
    <color name="task_progress_button_tint">@color/task_color_primary</color>
    <color name="task_progress_button_tint_disabled">@color/task_color_on_surface_muted</color>

    <color name="task_calendar_background">#FFEAF2FA</color>
    <color name="task_calendar_outline">#FF9BB7D4</color>
    <color name="task_calendar_chip_background">#FFD6E7F7</color>

    <!-- Widget-specific semantic colors mapped to base palette -->
    <color name="task_widget_surface">@color/task_color_surface</color>
    <color name="task_widget_surface_secondary">@color/task_color_surface_variant</color>
    <color name="task_widget_text_primary">@color/task_color_on_surface</color>
    <color name="task_widget_text_secondary">@color/task_color_on_surface_emphasis</color>
    <color name="task_widget_text_muted">@color/task_color_on_surface_muted</color>

    <!-- Widget task row title states -->
    <color name="task_widget_title_default">@color/task_widget_text_primary</color>
    <color name="task_widget_title_in_progress">@color/task_color_primary</color>
    <color name="task_widget_title_completed">@color/task_widget_text_muted</color>

    <!-- Opacity/transparency variants for UI elements -->
    <color name="task_color_on_primary_light">#4DF8F6EE</color>
    <color name="task_color_surface_semi_transparent">#CCFFFCF6</color>
    <color name="task_color_outline_semi">#80C5BFAF</color>

    <!-- Gradient colors -->
    <color name="task_gradient_start">#FFEAF2E4</color>
    <color name="task_gradient_center">#FFF4F1E8</color>
    <color name="task_gradient_end">#FFE5ECDD</color>
</resources>
