<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Global rule: app-wide tokens stay in generic files; feature-specific resources belong
         in feature-prefixed files (for example task_colors.xml).

         Color naming conventions:
         - Material palette: color_[role] (e.g., color_primary, color_on_surface)
           Reference: https://m3.material.io/styles/color/the-color-system/color-roles
         - Semantic purpose: [feature]_[domain]_[status] (e.g., task_deadline_overdue, budget_positive)
         - Component-scoped: [feature]_[component]_[role] (e.g., task_widget_text_primary)
         Prefer semantic or role-based names. Use component names only for UI-specific overrides. -->

    <color name="transparent">#00000000</color>
    <color name="launcher_icon_background">#0D3B52</color>
    <color name="launcher_icon_monochrome">#FF000000</color>
    <color name="launcher_icon_white">#FFFFFFFF</color>
    <color name="launcher_icon_accent">#D9EDF7</color>

    <!-- App-wide Material palette (nature-inspired). Source of truth for AppTheme.
         Primary color (color_primary = #FF5C7A4D) is the source for all derived tokens.
         When changing primary: update color_primary_variant, on_primary, alpha-composited
         variants, and task_colors.xml tokens that reference these via aliases. -->

    <!-- Nature-inspired base palette -->
    <color name="color_background">#FFF4F1E8</color>
    <color name="color_surface">#FFFFFCF6</color>
    <color name="color_surface_variant">#FFF0E8D6</color>
    <color name="color_on_surface">#FF2F3A2C</color>
    <color name="color_on_surface_variant">#FF5F6C58</color>
    <color name="color_on_surface_emphasis">#FF3F4D3A</color>
    <color name="color_on_surface_muted">#FF5F6858</color>
    <color name="color_outline">#FFC5BFAF</color>

    <color name="color_primary">#FF5C7A4D</color>
    <color name="color_primary_variant">#FF49653D</color>
    <color name="color_on_primary">#FFF8F6EE</color>
    <color name="color_primary_disabled_50">#805C7A4D</color>
    <color name="color_primary_disabled_8">#145C7A4D</color>
    <color name="color_primary_disabled_25">#405C7A4D</color>
    <color name="color_secondary">#FF8DAA8C</color>
    <color name="color_accent">#FFCF8F4F</color>
    <color name="color_negative">#FFB4543A</color>
    <color name="color_tertiary">#FF7A4DA8</color>

    <!-- Opacity/transparency variants for UI elements -->
    <color name="color_on_primary_light">#4DF8F6EE</color>
    <color name="color_surface_semi_transparent">#CCFFFCF6</color>
    <color name="color_outline_semi">#80C5BFAF</color>

    <!-- Gradient colors (app window background + widget root) -->
    <color name="gradient_start">#FFEAF2E4</color>
    <color name="gradient_center">#FFF4F1E8</color>
    <color name="gradient_end">#FFE5ECDD</color>
</resources>
