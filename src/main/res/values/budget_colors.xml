<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Global rule: app-wide tokens stay in generic files; feature-specific resources belong in feature-prefixed files.
         Budget color groups:
         - Semantic status: budget_positive (green), budget_negative (red), budget_warning (orange), budget_neutral (grey)
           Used for transaction amounts, balance indicators, and status text.
         - Chart: budget_chart_line, budget_chart_axis, budget_chart_label
           Used by BudgetBalanceChartView for the balance timeline chart.
         - UI: budget_divider (list dividers in budget overview)
         - Widget: budget_widget_header_text, budget_widget_card_text (home-screen widget text)
         Naming: budget_[domain]_[role] — see colors.xml header for full naming conventions.
         For new colors, use semantic names that describe purpose, not appearance. -->

    <!-- Semantic status colors -->
    <color name="budget_positive">#FF4CAF50</color>
    <color name="budget_negative">#FFF44336</color>
    <color name="budget_warning">#FFFF9800</color>
    <color name="budget_neutral">#FF9E9E9E</color>
    <color name="budget_chart_line">#FF1976D2</color>
    <color name="budget_chart_axis">#FFBDBDBD</color>
    <color name="budget_chart_label">#FF616161</color>
    <color name="budget_divider">#FFDDDDDD</color>

    <!-- Widget semantic tokens (parallel to task_widget_text_primary etc.) -->
    <color name="budget_widget_header_text">@color/task_color_on_primary</color>
    <color name="budget_widget_card_text">@color/task_color_on_surface</color>
</resources>
