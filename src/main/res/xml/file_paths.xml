<?xml version="1.0" encoding="utf-8"?>
<!-- FileProvider configuration for app self-updates.
     This file defines a cache-path that allows the app to securely share the downloaded APK
     with the system installer during self-updates. See UpdateChecker (app/update/UpdateChecker.java)
     for the update download and installation flow.

     Android framework requirement: FileProvider must declare allowed paths via this XML
     instead of allowing broad file access, as a security measure. The "update_apk" cache
     path name is referenced in AndroidManifest.xml FileProvider configuration. -->
<paths>
    <cache-path
        name="update_apk"
        path="update.apk" />
</paths>
