<?xml version="1.0" encoding="utf-8"?>
<!-- Task widget configuration
     Update period: 30 minutes (1800000ms)
     Must match: com.autosecretary.shared.WidgetConfiguration.WIDGET_UPDATE_PERIOD_MILLIS
     Shared with: budget widget (widget_budget_info.xml) -->
<appwidget-provider
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="180dp"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/task_list_widget"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
