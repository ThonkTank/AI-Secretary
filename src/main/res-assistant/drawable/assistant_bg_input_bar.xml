<?xml version="1.0" encoding="utf-8"?>
<!-- Assistant chat: the rounded input pill wrapping the attach button, message field, and send
     button. Surface fill with an outline, matching the app's card corner radius. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@color/color_surface" />
    <stroke android:width="@dimen/outline_stroke_width" android:color="@color/color_outline" />
    <corners android:radius="@dimen/corner_radius_lg" />
</shape>
