<?xml version="1.0" encoding="utf-8"?>
<!-- Assistant chat: a proposal/confirmation card nested under an answer. Low-alpha accent tint so
     it reads as a distinct "action needed" surface, set apart from the plain answer bubble. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@color/assistant_proposal_surface" />
    <stroke android:width="@dimen/outline_stroke_width" android:color="@color/color_outline" />
    <corners android:radius="@dimen/corner_radius_sm" />
</shape>
