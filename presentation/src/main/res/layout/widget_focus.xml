<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/WidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget"
    android:padding="12dp">

    <ImageView
        android:id="@+id/WidgetDaylight"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <ImageView
        android:id="@+id/WidgetForest"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_forest" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="30dp">

        <LinearLayout
            android:id="@+id/WidgetHeader"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/WidgetGreeting"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/newsreader_light_italic"
                android:text="Guten Morgen"
                android:textColor="@color/marker"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/WidgetAdd"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_chip_selected"
                android:gravity="center"
                android:text="＋"
                android:textColor="@color/action_text"
                android:textSize="20sp" />
        </LinearLayout>

        <ListView
            android:id="@+id/WidgetList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@android:color/transparent"
            android:dividerHeight="8dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/WidgetEmpty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dashed_leaf"
            android:fontFamily="@font/newsreader"
            android:gravity="center"
            android:padding="18dp"
            android:text="Heute darf ein neues Blatt wachsen."
            android:textColor="@color/ink"
            android:textSize="20sp" />
    </LinearLayout>
</FrameLayout>
