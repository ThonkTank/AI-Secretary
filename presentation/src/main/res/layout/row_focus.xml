<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/FocusLeaf"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_leaf_focus"
    android:elevation="10dp"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="22dp"
    android:paddingEnd="24dp"
    android:paddingBottom="20dp">

    <TextView
        android:id="@+id/FocusPosition"
        style="@style/WaldMarker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="jetzt"
        android:textColor="@color/forest"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/FocusTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/newsreader"
        android:lineSpacingMultiplier="1.04"
        android:maxLines="3"
        android:textColor="@color/ink"
        android:textSize="37sp" />

    <TextView
        android:id="@+id/FocusMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:lineSpacingMultiplier="1.3"
        android:textColor="@color/ink_muted"
        android:textSize="16sp" />

    <LinearLayout
        android:id="@+id/FocusSteps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical" />

    <LinearLayout
        android:id="@+id/FocusActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="start|center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/FocusDone"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:text="@string/done"
            app:icon="@null" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/FocusLater"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="später"
            android:textAllCaps="false"
            android:textColor="@color/ink_muted" />

        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/FocusOrder"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Reihenfolge ändern"
            android:minWidth="48dp"
            android:text="⋮"
            android:textAllCaps="false"
            android:textColor="@color/marker"
            android:textSize="22sp" />
    </LinearLayout>
</LinearLayout>
