<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/Root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingTop="28dp"
    android:paddingEnd="22dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/AllHeading" style="@style/WaldTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Alles" />
        <com.google.android.material.button.MaterialButton android:id="@+id/AddFab" android:layout_width="wrap_content" android:layout_height="40dp" android:text="＋" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/FilterOpen" style="@style/WaldMarker" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center" android:paddingEnd="22dp" android:text="offen" />
        <TextView android:id="@+id/FilterRoutines" style="@style/WaldMarker" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center" android:paddingEnd="22dp" android:text="Routinen" />
        <TextView android:id="@+id/FilterDone" style="@style/WaldMarker" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center" android:text="erledigt" />
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/ObligationList" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="18dp" />
    <LinearLayout android:id="@+id/CompletedCleanup" android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Erledigtes älter als 30 Tage" android:textColor="@color/marker" />
        <TextView android:id="@+id/CompletedCleanupAction" android:layout_width="wrap_content" android:layout_height="48dp" android:gravity="center" android:text="aufräumen" android:textColor="@color/ink_secondary" />
    </LinearLayout>
</LinearLayout>
