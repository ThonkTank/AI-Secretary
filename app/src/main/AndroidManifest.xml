<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.secretary"
    android:versionCode="327"
    android:versionName="0.3.27">

    <uses-sdk
        android:minSdkVersion="28"
        android:targetSdkVersion="35" />

    <!-- Permissions für Update-System -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:label="@string/app_name"
        android:theme="@style/Theme.AISecretary">

        <activity
            android:name=".app.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".TaskActivity"
            android:label="Tasks"
            android:exported="false" />

        <activity
            android:name=".features.dreams.presentation.activity.CreateDreamActivity"
            android:label="Create Dream"
            android:parentActivityName=".app.MainActivity"
            android:exported="false" />
    </application>
</manifest>
