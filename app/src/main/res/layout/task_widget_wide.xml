<?xml version="1.0"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_background">
  <ImageView android:id="@+id/widget_forest" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/widget_forest"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:paddingStart="30dp" android:paddingTop="14dp" android:paddingEnd="14dp" android:paddingBottom="14dp">
    <LinearLayout android:layout_width="150dp" android:layout_height="match_parent" android:orientation="vertical">
      <TextView android:id="@+id/widget_marker" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/newsreader_italic" android:includeFontPadding="false" android:text="@string/marker_now" android:textColor="#2E6B44" android:textSize="15sp"/>
      <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:ellipsize="end" android:fontFamily="@font/newsreader" android:includeFontPadding="false" android:maxLines="2" android:textColor="#1A2618" android:textSize="23sp"/>
      <TextView android:id="@+id/widget_action" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/widget_button" android:fontFamily="@font/alegreya_sans_bold" android:gravity="center" android:textColor="#FCFAF2" android:textSize="14sp"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_steps" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="vertical">
      <LinearLayout android:id="@+id/widget_step_row_1" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_step_dot_1" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="@string/widget_step_open_symbol" android:textColor="#B0A385" android:textSize="25sp"/>
        <TextView android:id="@+id/widget_step_text_1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:fontFamily="@font/alegreya_sans" android:maxLines="1" android:textColor="#1A2618" android:textSize="18sp"/>
      </LinearLayout>
      <LinearLayout android:id="@+id/widget_step_row_2" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_step_dot_2" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="@string/widget_step_open_symbol" android:textColor="#B0A385" android:textSize="25sp"/>
        <TextView android:id="@+id/widget_step_text_2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:fontFamily="@font/alegreya_sans" android:maxLines="1" android:textColor="#1A2618" android:textSize="18sp"/>
      </LinearLayout>
      <LinearLayout android:id="@+id/widget_step_row_3" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_step_dot_3" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="@string/widget_step_open_symbol" android:textColor="#B0A385" android:textSize="25sp"/>
        <TextView android:id="@+id/widget_step_text_3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:fontFamily="@font/alegreya_sans" android:maxLines="1" android:textColor="#1A2618" android:textSize="18sp"/>
      </LinearLayout>
      <TextView android:id="@+id/widget_more" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/newsreader_italic" android:textColor="#6D7860" android:textSize="13sp"/>
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
