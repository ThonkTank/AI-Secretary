<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent"
    android:layout_height="match_parent" android:background="@drawable/widget_background">
    <ImageView android:id="@+id/widget_forest" android:layout_width="match_parent"
        android:layout_height="match_parent" android:importantForAccessibility="no"
        android:scaleType="fitXY" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:paddingStart="30dp" android:paddingTop="14dp"
        android:paddingEnd="14dp" android:paddingBottom="9dp">
        <TextView android:id="@+id/widget_marker" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:fontFamily="@font/newsreader_italic"
            android:fontVariationSettings="'wght' 300"
            android:includeFontPadding="false" android:text="@string/marker_now"
            android:textColor="#2E6B44" android:textSize="15sp" />
        <TextView android:id="@+id/widget_title" android:layout_width="126dp"
            android:layout_height="wrap_content" android:layout_marginTop="5dp"
            android:ellipsize="end" android:fontFamily="@font/newsreader"
            android:fontVariationSettings="'wght' 200"
            android:includeFontPadding="false" android:maxLines="1" android:singleLine="true"
            android:textScaleX="0.92"
            android:textColor="#1A2618" android:textSize="22sp" />
        <LinearLayout android:id="@+id/widget_progress" android:layout_width="wrap_content"
            android:layout_height="5dp" android:layout_marginTop="10dp" android:orientation="horizontal">
            <ImageView android:id="@+id/widget_progress_1" android:layout_width="20dp" android:layout_height="5dp" />
            <ImageView android:id="@+id/widget_progress_2" android:layout_width="20dp" android:layout_height="5dp" android:layout_marginStart="6dp" />
            <ImageView android:id="@+id/widget_progress_3" android:layout_width="20dp" android:layout_height="5dp" android:layout_marginStart="6dp" />
        </LinearLayout>
        <TextView android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
        <FrameLayout android:id="@+id/widget_action_target" android:layout_width="match_parent"
            android:layout_height="48dp">
            <ImageView android:id="@+id/widget_action_background" android:layout_width="match_parent"
                android:layout_height="38dp" android:layout_gravity="center" android:scaleType="fitXY" />
            <TextView android:id="@+id/widget_action" android:layout_width="match_parent"
                android:layout_height="48dp" android:fontFamily="@font/alegreya_sans_bold"
                android:gravity="center" android:textColor="#FCFAF2" android:textSize="14sp" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
