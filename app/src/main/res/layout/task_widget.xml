<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_background">
    <ImageView android:id="@+id/widget_forest" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/widget_forest" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="30dp" android:paddingTop="14dp" android:paddingEnd="14dp" android:paddingBottom="14dp">
        <TextView android:id="@+id/widget_marker" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/newsreader_italic" android:includeFontPadding="false" android:text="jetzt" android:textColor="#2E6B44" android:textSize="15sp" />
        <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:ellipsize="end" android:fontFamily="@font/newsreader" android:includeFontPadding="false" android:maxLines="2" android:textColor="#1A2618" android:textSize="22sp" />
        <LinearLayout android:id="@+id/widget_progress" android:layout_width="wrap_content" android:layout_height="5dp" android:layout_marginTop="10dp" android:orientation="horizontal">
            <View android:id="@+id/widget_progress_1" android:layout_width="20dp" android:layout_height="5dp" android:background="@drawable/widget_progress_off" />
            <View android:id="@+id/widget_progress_2" android:layout_width="20dp" android:layout_height="5dp" android:layout_marginStart="6dp" android:background="@drawable/widget_progress_off" />
            <View android:id="@+id/widget_progress_3" android:layout_width="20dp" android:layout_height="5dp" android:layout_marginStart="6dp" android:background="@drawable/widget_progress_off" />
        </LinearLayout>
        <TextView android:id="@+id/widget_action" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="4dp" android:layout_weight="1" android:background="@drawable/widget_button" android:fontFamily="@font/alegreya_sans_bold" android:gravity="center" android:maxHeight="48dp" android:textColor="#FCFAF2" android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
