<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent"
    android:layout_height="match_parent" android:background="@drawable/widget_background">
    <ImageView android:id="@+id/widget_forest" android:layout_width="match_parent"
        android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitXY" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:paddingStart="44dp" android:paddingTop="14dp"
        android:paddingEnd="14dp" android:paddingBottom="14dp">
        <FrameLayout android:layout_width="match_parent" android:layout_height="30dp" android:clipChildren="false">
            <TextView android:id="@+id/widget_marker" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:fontFamily="@font/newsreader_italic" android:fontVariationSettings="'wght' 300"
                android:includeFontPadding="false"
                android:text="@string/marker_now" android:textColor="#E8A83E" android:textSize="15sp" />
            <FrameLayout android:id="@+id/widget_add_target" android:layout_width="48dp" android:layout_height="48dp"
                android:layout_gravity="top|end" android:layout_marginTop="-9dp">
                <ImageView android:id="@+id/widget_add_background" android:layout_width="30dp"
                    android:layout_height="30dp" android:layout_gravity="center"
                    android:importantForAccessibility="no" android:scaleType="fitXY" />
                <TextView android:id="@+id/widget_add" android:layout_width="48dp" android:layout_height="48dp"
                    android:fontFamily="@font/alegreya_sans" android:gravity="center"
                    android:text="@string/widget_add_symbol" android:textColor="#14201A" android:textSize="20sp" />
            </FrameLayout>
        </FrameLayout>
        <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:ellipsize="end" android:fontFamily="@font/newsreader" android:fontVariationSettings="'wght' 200"
            android:includeFontPadding="false"
            android:maxLines="2" android:textColor="#F4EEDA" android:textSize="28sp" />
        <LinearLayout android:id="@+id/widget_steps" android:layout_width="match_parent" android:layout_height="123dp"
            android:layout_marginTop="12dp" android:clipChildren="false" android:orientation="vertical">
            <include layout="@layout/widget_step_row_1" />
            <include layout="@layout/widget_step_row_2" />
            <include layout="@layout/widget_step_row_3" />
        </LinearLayout>
        <FrameLayout android:id="@+id/widget_after_leaf" android:layout_width="match_parent" android:layout_height="62dp"
            android:layout_marginTop="7dp">
            <ImageView android:id="@+id/widget_after_background" android:layout_width="match_parent"
                android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitXY" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                android:gravity="center_vertical" android:orientation="vertical"
                android:paddingStart="16dp" android:paddingEnd="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:fontFamily="@font/newsreader_italic" android:fontVariationSettings="'wght' 300"
                    android:includeFontPadding="false"
                    android:text="@string/marker_after" android:textColor="#8E9A84" android:textSize="13sp" />
                <TextView android:id="@+id/widget_after_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:ellipsize="end" android:fontFamily="@font/newsreader" android:includeFontPadding="false"
                    android:maxLines="1" android:textColor="#F4EEDA" android:textSize="19sp" />
            </LinearLayout>
        </FrameLayout>
        <FrameLayout android:id="@+id/widget_calendar_leaf" android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_marginTop="10dp" android:layout_weight="1">
            <ImageView android:id="@+id/widget_calendar_background" android:layout_width="match_parent"
                android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitXY" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                android:gravity="center_vertical" android:orientation="vertical"
                android:paddingStart="16dp" android:paddingEnd="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <TextView android:id="@+id/widget_calendar_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="@font/alegreya_sans_bold" android:includeFontPadding="false"
                        android:textColor="#8FBACB" android:textSize="18sp" />
                    <TextView android:id="@+id/widget_calendar_title" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_marginStart="9dp" android:layout_weight="1" android:ellipsize="end"
                        android:fontFamily="@font/newsreader" android:includeFontPadding="false"
                        android:maxLines="1" android:textColor="#8FBACB" android:textSize="21sp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:fontFamily="@font/newsreader_italic" android:fontVariationSettings="'wght' 300"
                    android:includeFontPadding="false"
                    android:text="@string/calendar_fixed" android:textColor="#7096A6" android:textSize="14sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
