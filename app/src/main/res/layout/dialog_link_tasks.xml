<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/linkTasksHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Link task to milestones:"
        android:textSize="14sp"
        android:textColor="#757575"
        android:layout_marginBottom="16dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="300dp">

        <LinearLayout
            android:id="@+id/milestonesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tip: Tasks can contribute to multiple milestones across different dreams. Full XP goes to each linked milestone!"
        android:textSize="12sp"
        android:textColor="#9E9E9E"
        android:layout_marginTop="16dp" />

</LinearLayout>
