<?xml version="1.0"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_background">
  <ImageView android:id="@+id/widget_forest" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/widget_forest"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="36dp" android:paddingTop="14dp" android:paddingEnd="14dp" android:paddingBottom="14dp">
    <TextView android:id="@+id/widget_marker" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/newsreader_italic" android:includeFontPadding="false" android:text="@string/marker_now" android:textColor="#E8A83E" android:textSize="15sp"/>
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:fontFamily="@font/newsreader" android:includeFontPadding="false" android:maxLines="2" android:textColor="#F4EEDA" android:textSize="26sp"/>
    <LinearLayout android:id="@+id/widget_steps" android:layout_width="match_parent" android:layout_height="144dp" android:layout_marginTop="8dp" android:orientation="vertical">
      <LinearLayout android:id="@+id/widget_step_row_1" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_step_dot_1" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="@string/widget_step_open_symbol" android:textColor="#68715A" android:textSize="27sp"/>
        <TextView android:id="@+id/widget_step_text_1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="@font/alegreya_sans" android:textColor="#F4EEDA" android:textSize="18sp"/>
      </LinearLayout>
      <LinearLayout android:id="@+id/widget_step_row_2" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_step_dot_2" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="@string/widget_step_open_symbol" android:textColor="#68715A" android:textSize="27sp"/>
        <TextView android:id="@+id/widget_step_text_2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="@font/alegreya_sans" android:textColor="#F4EEDA" android:textSize="18sp"/>
      </LinearLayout>
      <LinearLayout android:id="@+id/widget_step_row_3" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_step_dot_3" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="@string/widget_step_open_symbol" android:textColor="#68715A" android:textSize="27sp"/>
        <TextView android:id="@+id/widget_step_text_3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="@font/alegreya_sans" android:textColor="#F4EEDA" android:textSize="18sp"/>
      </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/widget_action" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/widget_button" android:fontFamily="@font/alegreya_sans_bold" android:gravity="center" android:textColor="#14201A" android:textSize="15sp"/>
    <LinearLayout android:id="@+id/widget_calendar_leaf" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="12dp" android:layout_weight="1" android:background="@drawable/widget_leaf_calendar" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_calendar_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/alegreya_sans_bold" android:textColor="#8FBACB" android:textSize="18sp"/>
        <TextView android:id="@+id/widget_calendar_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="9dp" android:layout_weight="1" android:ellipsize="end" android:fontFamily="@font/newsreader" android:maxLines="1" android:textColor="#8FBACB" android:textSize="21sp"/>
      </LinearLayout>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/newsreader_italic" android:text="@string/calendar_fixed" android:textColor="#7096A6" android:textSize="14sp"/>
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
