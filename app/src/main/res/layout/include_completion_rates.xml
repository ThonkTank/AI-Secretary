<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="@dimen/spacing_md"
    android:background="@color/colorSurface">

    <!-- Today Card -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="@dimen/spacing_sm">

        <FrameLayout
            android:layout_width="@dimen/progress_indicator_size"
            android:layout_height="@dimen/progress_indicator_size">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/todayProgressIndicator"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:indicatorSize="@dimen/progress_indicator_size"
                app:trackThickness="@dimen/progress_indicator_stroke"
                app:indicatorColor="@color/completion_perfect"
                app:trackColor="@color/divider" />

            <TextView
                android:id="@+id/todayPercentText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="0%"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:text="Today"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/todayDetailText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 of 0 tasks"
            android:textSize="12sp"
            android:textColor="@color/text_secondary" />

    </LinearLayout>

    <!-- Week Card -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="@dimen/spacing_sm">

        <FrameLayout
            android:layout_width="@dimen/progress_indicator_size"
            android:layout_height="@dimen/progress_indicator_size">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/weekProgressIndicator"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:indicatorSize="@dimen/progress_indicator_size"
                app:trackThickness="@dimen/progress_indicator_stroke"
                app:indicatorColor="@color/completion_perfect"
                app:trackColor="@color/divider" />

            <TextView
                android:id="@+id/weekPercentText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="0%"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:text="This Week"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/weekDetailText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 of 0 tasks"
            android:textSize="12sp"
            android:textColor="@color/text_secondary" />

    </LinearLayout>

</LinearLayout>
