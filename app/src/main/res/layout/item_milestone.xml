<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Title Row with Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/milestoneTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Milestone Title"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#212121" />

            <TextView
                android:id="@+id/milestoneStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="In Progress"
                android:textSize="12sp"
                android:textColor="#2196F3" />
        </LinearLayout>

        <!-- Prerequisite Indicator -->
        <TextView
            android:id="@+id/milestonePrereqIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔗 2 Voraussetzungen"
            android:textSize="12sp"
            android:textColor="#2196F3"
            android:layout_marginTop="4dp"
            android:visibility="gone" />

        <!-- Description -->
        <TextView
            android:id="@+id/milestoneDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Description"
            android:textSize="14sp"
            android:textColor="#757575"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="4dp"
            android:visibility="gone" />

        <!-- XP Progress -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp">

            <ProgressBar
                android:id="@+id/milestoneXpProgress"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="0dp"
                android:layout_height="8dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="50" />

            <TextView
                android:id="@+id/milestoneXpText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="500/1000 XP"
                android:textSize="12sp"
                android:textColor="#757575"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Complete Button -->
        <Button
            android:id="@+id/milestoneCompleteButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Complete"
            android:textSize="12sp"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            style="?android:attr/buttonBarButtonStyle" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
