<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/task_editor_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/task_editor_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="60dp"
            android:paddingEnd="22dp">

            <TextView
                android:id="@+id/task_editor_cancel"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:text="@string/editor_cancel"
                android:textSize="17sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/task_editor_context"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:fontFamily="@font/newsreader_italic"
                android:gravity="center_vertical"
                android:textSize="18sp" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/task_editor_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="false"
            android:paddingStart="60dp"
            android:paddingTop="8dp"
            android:paddingEnd="22dp"
            android:paddingBottom="18dp">

            <LinearLayout
                android:id="@+id/task_editor_leaf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="26dp"
                android:paddingTop="24dp"
                android:paddingEnd="26dp"
                android:paddingBottom="24dp" />
        </ScrollView>

        <LinearLayout
            android:id="@+id/task_editor_actions"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="60dp"
            android:paddingEnd="22dp">

            <Button
                android:id="@+id/task_editor_save"
                style="@style/SentenceButton"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:minWidth="0dp"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:text="@string/action_save"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/task_editor_discard"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="18dp"
                android:gravity="center"
                android:text="@string/action_discard"
                android:textSize="17sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/task_editor_delete"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="@string/action_delete"
                android:textSize="17sp" />

            <LinearLayout
                android:id="@+id/task_editor_progress"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/task_editor_prompt_host"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
