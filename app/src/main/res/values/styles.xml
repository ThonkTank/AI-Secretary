<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- App Theme -->
    <style name="Theme.AISecretary" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryVariant</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorSecondaryVariant">@color/colorSecondaryVariant</item>
        <item name="colorOnSecondary">@color/colorOnSecondary</item>
        <item name="android:colorBackground">@color/colorBackground</item>
    </style>

    <!-- Streak Card Style -->
    <style name="Widget.AISecretary.Card.Streak" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/corner_radius_lg</item>
        <item name="cardElevation">2dp</item>
        <item name="contentPadding">@dimen/spacing_md</item>
    </style>

    <!-- Completion Progress Style -->
    <style name="Widget.AISecretary.ProgressIndicator" parent="Widget.MaterialComponents.CircularProgressIndicator">
        <item name="indicatorSize">@dimen/progress_indicator_size</item>
        <item name="trackThickness">@dimen/progress_indicator_stroke</item>
        <item name="trackColor">@color/divider</item>
    </style>

    <!-- Motivational Text Style -->
    <style name="TextAppearance.AISecretary.Motivation" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textStyle">italic</item>
        <item name="android:textColor">@color/colorOnPrimary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Streak Text Styles -->
    <style name="TextAppearance.AISecretary.Streak.Current" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.AISecretary.Streak.Best" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/text_secondary</item>
    </style>
</resources>
